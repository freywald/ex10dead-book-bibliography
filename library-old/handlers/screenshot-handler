#!/bin/bash

# configuration start

screenshot_cookie_file="$gallery_dl_cookie_file"
screenshot_page_script="Build/libraries/handlers/screenshot-handler-page.js"
screenshot_maximum_height=16000
screenshot_width="640"
screenshot_viewport_height="800"
screenshot_browser_device_pixel_ratio=4
screenshot_zoom=1
screenshot_reply_count=3

# configuration end

# script task start

handler_screenshot_handle_output_path() {
	local output_directory="$1"
	local out_dir out_name archive_dir mtime dest dest_base i

	out_dir="$(dirname -- "$output_directory")"
	mkdir --parents -- "$out_dir"

	if [[ ! -f "$output_directory" ]]; then
		return 0
	fi

	archive_dir="$out_dir/__backups"
	mkdir --parents -- "$archive_dir"

	out_name="$(basename -- "$output_directory")"
	mtime="$(date -r "$output_directory" +%d-%m-%Y-%H-%M-%S)"
	dest_base="${archive_dir}/${out_name}-${mtime}"
	dest="$dest_base"

	i=1
	while [[ -e "$dest" ]]; do
		dest="${dest_base}_${i}"
		i=$((i + 1))
	done

	mv -- "$output_directory" "$dest"
	__info "Archived %s -> %s" "$output_directory" "$dest"
}

handler_screenshot_twitter_cookies_json() {
	local cookie_file="$1"
	local line rest domain flag path secure expires name value
	local http_only host
	local -a json_items=()

	if [[ ! -f "$cookie_file" ]]; then
		__info "Missing cookie file: %s" "$cookie_file"
		return 1
	fi

	while IFS= read -r line || [[ -n "$line" ]]; do
		http_only=false
		if [[ "$line" == "#HttpOnly_"* ]]; then
			http_only=true
			line="${line#\#HttpOnly_}"
		elif [[ "$line" == \#* || -z "$line" ]]; then
			continue
		fi

		IFS=$'\t' read -r domain flag path secure expires name value rest <<<"$line" || __expression_may_fail
		unset flag rest

		if [[ -z "$domain" || -z "$name" ]]; then
			continue
		fi

		host="${domain#.}"

		if [[ ! "$expires" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
			expires="-1"
		fi

		json_items+=(
			"$(
				jq -nc \
					--arg name "$name" \
					--arg value "$value" \
					--arg domain "$domain" \
					--arg path "${path:-/}" \
					--arg secure "$secure" \
					--arg expires "$expires" \
					--argjson httpOnly "$http_only" \
					'{
						name: $name,
						value: $value,
						domain: $domain,
						path: ($path | if . == "" then "/" else . end),
						expires: (
							($expires | tonumber | floor) as $exp
							| if $exp > 0 then $exp else -1 end
						),
						httpOnly: $httpOnly,
						secure: (($secure | ascii_upcase) == "TRUE"),
						sameSite: (if ($secure | ascii_upcase) == "TRUE" then "None" else "Lax" end)
					}'
			)"
		)
	done < "$cookie_file"

	if [[ ${#json_items[@]} -eq 0 ]]; then
		__info "No cookies in %s" "$cookie_file"
		return 1
	fi

	printf '%s\n' "${json_items[@]}" | jq -s '.' || abort_on_interrupt $?
}

handler_screenshot_cookies_to_storage_state() {
	local cookie_file="$1"
	local out_json="$2"
	local cookies

	cookies="$(handler_screenshot_twitter_cookies_json "$cookie_file")" || return 55
	jq -n --argjson cookies "$cookies" '{cookies: $cookies, origins: []}' >| "$out_json" || abort_on_interrupt $?
}

handler_screenshot_require_page_script() {
	if [[ ! -f "$screenshot_page_script" ]]; then
		__info "Missing page script: %s" "$screenshot_page_script"
		return 1
	fi
}

handler_screenshot_log_failure() {
	local url="$1" reason="$2" tool_log="$3" json_path
	json_path="$(gallerydl_json_for_url "$url")" || json_path=""
	{
		printf 'url: %s\n' "$url"
		printf 'json: %s\n' "$json_path"
		printf 'reason: %s\n' "$reason"
		printf '%s\n' '--- shot-scraper ---'
		[[ -f "$tool_log" ]] && cat -- "$tool_log"
		printf '\n'
	} >> "$run_error_log"
	if [[ -n "$json_path" ]] && ! grep -qxF -- "$json_path" "$run_missing_screenshots_log"; then
		printf '%s\n' "$url" >> "$run_missing_screenshots_log"
		printf '%s\n\n' "$json_path" >> "$run_missing_screenshots_log"
	fi
}

handler_make_screenshot_with_shot_scraper() {
	local url="$1"
	local output_directory="$2"
	local auth_file js_file
	local status=0
	local max_h="$screenshot_maximum_height"

	if [[ -f "$output_directory" ]] && ! $force_update_existing; then
		__verbose "Skipping screenshot %s, file exists" "$output_directory"
		return 0
	fi

	__info "Writing screenshot to: %s" "$screenshot_path"

	handler_screenshot_handle_output_path "$output_directory" || return $?
	handler_screenshot_require_page_script || return 22

	auth_file="$(mktemp --suffix=.json)"
	js_file="$(mktemp --suffix=.js)"

	if ! handler_screenshot_cookies_to_storage_state "$screenshot_cookie_file" "$auth_file"; then
		rm -f -- "$auth_file" "$js_file"
		return 21
	fi

	{
		printf 'window.__SCREENSHOT_MAX_HEIGHT__ = %s;\n' "$max_h"
		printf 'window.__SCREENSHOT_VIEWPORT_HEIGHT__ = %s;\n' "$screenshot_viewport_height"
		printf 'window.__SCREENSHOT_ZOOM__ = %s;\n' "$screenshot_zoom"
		printf 'window.__SCREENSHOT_REPLY_COUNT__ = %s;\n' "$screenshot_reply_count"
		cat -- "$screenshot_page_script"
	} >| "$js_file"

	local log_file
	log_file="$(mktemp)"

	shot-scraper "$url" --output "$output_directory" --log-console --width "$screenshot_width" --scale-factor "$screenshot_browser_device_pixel_ratio" --format png --auth "$auth_file" --js-file "$js_file" --bypass-csp --reduced-motion --timeout 120000 --wait 10000 --wait-for "document.documentElement.getAttribute('data-screenshot-ready') === '1'" >| "$log_file" 2>&1 || status=$?
	cat -- "$log_file" >&2
	abort_on_interrupt "$status"
	if grep -q 'status of 429' -- "$log_file"; then
		handler_screenshot_log_failure "$url" "HTTP 429" "$log_file"
		__warn "HTTP 429 while screenshotting %s, screenshot file not kept" "$url"
		[[ -f "$output_directory" ]] && rm -f -- "$output_directory"
		rm -f -- "$auth_file" "$js_file" "$log_file"
		return 75
	fi
	if (( status != 0 )); then
		handler_screenshot_log_failure "$url" "shot-scraper exit $status" "$log_file"
		[[ -f "$output_directory" ]] && rm -f -- "$output_directory"
		rm -f -- "$auth_file" "$js_file" "$log_file"
		return "$status"
	fi

	rm -f -- "$log_file" "$auth_file" "$js_file"

	return 0
}
