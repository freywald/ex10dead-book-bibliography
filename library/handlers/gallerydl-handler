handler_gallerydl_tweet_complete() {
	local dir="$1" json="$2" media_count files=0 f tweet_id status=0
	[[ -f "$json" ]] || return 1
	tweet_id="$(basename -- "$json" .json)"
	for f in "$dir"/*.part "$dir"/*.part.*; do
		[[ -e "$f" ]] && return 1
	done
	media_count="$(jq -r '
		(.extended_entities.media // .entities.media // .media // [])
		| if type == "array" then . else [] end
		| map(select(type == "object" and (.type == "photo" or .type == "video" or .type == "animated_gif" or .type == "image")))
		| unique_by(.id_str // .media_key // .media_url_https // .url)
		| length
	' -- "$json" 2>/dev/null)" || status=$?
	abort_on_interrupt "$status"
	media_count="${media_count:-0}"
	[[ "$media_count" =~ ^[0-9]+$ ]] || media_count=0
	if (( media_count == 0 )); then
		return 0
	fi
	for f in "$dir/${tweet_id}_"*; do
		[[ -f "$f" ]] || continue
		case "$f" in
			*.part|*.part.*) continue ;;
		esac
		files=$((files + 1))
	done
	(( files >= media_count ))
}

handler_gallerydl_backup_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	local hash ext name found backup_dir dest
	hash="$(sha256sum -- "$file" | awk '{print $1}')"
	ext="${file##*.}"
	name="$hash.$ext.zip"
	found="$(find "$gallerydl_dump_path" -path '*/__backups/*'"/$name" -print -quit 2>/dev/null)" || true
	[[ -n "$found" ]] && return 0
	backup_dir="$(dirname -- "$(dirname -- "$file")")/__backups/backup-$(date "+%d.%m.%Y [%H∶%M∶%S]")"
	mkdir --parents -- "$backup_dir"
	dest="$backup_dir/$name"
	zip --no-wild -j -T "$dest" "$file" >/dev/null || return $?
	[[ -f "$dest" ]] || return 1
	__info "Wrote hash backup %s" "$dest"
}

handler_gallerydl_referenced_files() {
	local json="$1" dir="$2" tweet_id="$3" status=0 n file
	printf '%s\n' "$json"
	while IFS= read -r n; do
		[[ "$n" =~ ^[0-9]+$ ]] || continue
		for file in "$dir/${tweet_id}_${n}."*; do
			[[ -f "$file" ]] || continue
			printf '%s\n' "$file"
		done
	done < <(jq -r '
		(.extended_entities.media // .entities.media // [])
		| if type == "array" then . else [] end
		| to_entries[]
		| (.key + 1)
	' -- "$json") || status=$?
	abort_on_interrupt "$status"
	return "${status:-0}"
}

function handler_gallerydl_download() {
    local url="$1"
    local tweet_id json backup_dir status=0

    tweet_id="$(twitter_status_id "$url")"
    mkdir --parents -- "$gallerydl_dump_path"

    json="$(gallerydl_json_for_url "$url")" || abort_on_interrupt $?
    if [[ -n "$json" && -f "$json" ]] && handler_gallerydl_tweet_complete "$(dirname -- "$json")" "$json" && ! $force_update_existing; then
        __verbose "gallery-dl skipped, files complete"
        return 0
    fi
    __info "Downloading gallery-dl %s" "$url"

    if [[ -n "$json" && -f "$json" ]]; then
        local tweet_dir file
        tweet_dir="$(dirname -- "$json")"
        if $force_update_existing; then
            while IFS= read -r file; do
                [[ -f "$file" ]] || continue
                handler_gallerydl_backup_file "$file" || return $?
                [[ -f "$file" ]] && rm -f -- "$file"
            done < <(handler_gallerydl_referenced_files "$json" "$tweet_dir" "$(basename -- "$json" .json)")
        else
            handler_gallerydl_backup_file "$json" || return $?
        fi
    fi

	 __info "gallery-dl INVOKATION %s" "$url"
    gallery-dl -vvv --config-ignore --cookies "$gallery_dl_cookie_file" --mtime-from-date --sleep 20-60 --sleep-request 30-90 --retries 6 --http-timeout 60.0 --limit-rate 5M --option downloader.mtime=false --option downloader.progress=5.0 --option downloader.part-directory=/home/ju/Daten3/Temporary/System/tmp/ --option downloader.timeout=60.0 --option downloader.ytdl.module=yt_dlp --option extractor.base-directory="$gallerydl_dump_path/" --option extractor.path-restrict='{"\\":"⧹","/":"⧸","|":"￨",":":"꞉","*":"∗","?":"？","\"":"″","<":"﹤",">":"﹥"}' --option extractor.ytdl.enabled=true --option extractor.ytdl.module=yt_dlp --option extractor.ytdl.generic=false --option extractor.ytdl.config-file="$HOME/.config/yt-dlp/config" --option extractor.twitter.quoted=true --option extractor.twitter.unavailable=true --option extractor.twitter.cards=true --option extractor.twitter.retweets=true --option extractor.twitter.size=orig --option extractor.twitter.text-tweets=true --option extractor.twitter.twitpic=true --option extractor.twitter.directory='["{user[id]}","{tweet_id}"]' -P metadata -O event=post -O filename="{tweet_id}.json" -- "$url" || status=$?
    if (( status == 130 || status == 143 )); then
        exit "$status"
    fi
    return "${status:-0}"
}
