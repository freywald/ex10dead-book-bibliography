#!/bin/bash

# configuration start

screenshot_cookie_file=""
screenshot_page_script="$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/utilities/screenshot-handler-page.js"
screenshot_maximum_height=16000
screenshot_width="640"
screenshot_viewport_height="800"
screenshot_browser_device_pixel_ratio=4
screenshot_zoom=1
screenshot_reply_count=3

# configuration end

# script start

handler_webpage_archive_write_screenshot_with_screenshot_scraper_sourced=true

handler_webpage_archive_write_screenshot_with_screenshot_scraper_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-width" ]]; then
			screenshot_width="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-width="* ]]; then
			screenshot_width="${1#--webpage-archive-write-screenshot-with-screenshot-scraper-width=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-maximum-height" ]]; then
			screenshot_maximum_height="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-maximum-height="* ]]; then
			screenshot_maximum_height="${1#--webpage-archive-write-screenshot-with-screenshot-scraper-maximum-height=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-reply-count" ]]; then
			screenshot_reply_count="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-reply-count="* ]]; then
			screenshot_reply_count="${1#--webpage-archive-write-screenshot-with-screenshot-scraper-reply-count=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-zoom" ]]; then
			screenshot_zoom="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-zoom="* ]]; then
			screenshot_zoom="${1#--webpage-archive-write-screenshot-with-screenshot-scraper-zoom=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-scale-factor" ]]; then
			screenshot_browser_device_pixel_ratio="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-scale-factor="* ]]; then
			screenshot_browser_device_pixel_ratio="${1#--webpage-archive-write-screenshot-with-screenshot-scraper-scale-factor=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--webpage-archive-write-screenshot-with-screenshot-scraper-"* ]]; then
			__error "unknown webpage-archive-write-screenshot-with-screenshot-scraper argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done

	handler_remaining_arguments=("${arguments[@]}")
}

