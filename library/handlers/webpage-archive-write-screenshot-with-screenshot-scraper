	local reason="$2"
	local tool_log="$3"
	local output_path="$4"
	local json_path
	json_path="$(gallerydl_json_for_url "$url")" || json_path=""

	{
		printf 'url: %s\n' "$url"
		printf 'filename: %s\n' "$output_path"
		printf 'json file: %s\n' "$json_path"
		printf 'reason: %s\n' "$reason"
		printf '%s\n' '--- shot-scraper ---'
		[[ -f "$tool_log" ]] && cat -- "$tool_log"
		printf '\n'
	} >> "$run_error_log"
	printf '%s\n%s\n%s\n\n' "# output_path=$output_path" "# json_path=$json_path" "$url" >> "$run_directory/webpage-archive-write-screenshot-with-screenshot-scraper-failed-items.log"
	printf '%s\n%s\n%s\n\n' "# output_path=$output_path" "# json_path=$json_path" "$url" >> "$failed_items_log"
	
#	if [[ -n "$json_path" ]] && ! grep --quiet --line-regexp --fixed-strings -- "$json_path" "$run_missing_screenshots_log"; then
#		printf '%s\n' "$url" >> "$run_missing_screenshots_log"
#		printf '%s\n\n' "$json_path" >> "$run_missing_screenshots_log"
#	fi
}

handler_webpage_archive_write_screenshot_with_screenshot_scraper_backup_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0

	local status=0
	local hash
	hash="$(sha256sum -- "$file" | awk '{print $1}')" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		return "$status"
	fi
	[[ -z "$hash" ]] && return 1

	local extension="${file##*.}"
	local name="$hash.$extension.zip"
	local backup_directory
	backup_directory="$(backup_directory_for "$file" "$(handler_base_path "webpage-archive-write-screenshot-with-screenshot-scraper")" "${handler_leaf_name["webpage-archive-write-screenshot-with-screenshot-scraper"]-}")"
	mkdir --parents -- "$backup_directory"
	local destination="$backup_directory/$name"

	if [[ -f "$destination" ]]; then
		return 0
	fi

	status=0
	zip --no-wild --junk-paths --test "$destination" "$file" >"/dev/null" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		return "$status"
	fi

	__info "Wrote hash backup %s" "$destination"
}

handler_webpage_archive_write_screenshot_with_screenshot_scraper_twitter_cookies_json() {
	local cookie_file="$1"
	local line rest domain flag path secure expires name value
	local http_only
	local -a json_items=()

	if [[ ! -f "$cookie_file" ]]; then
		__info "Missing cookie file: %s" "$cookie_file"
		return 1
	fi

	while IFS= read -r line || [[ -n "$line" ]]; do
		http_only=false
		if [[ "$line" == "#HttpOnly_"* ]]; then
			http_only=true
			line="${line#\#HttpOnly_}"
		elif [[ "$line" == \#* || -z "$line" ]]; then
			continue
		fi

		IFS=$'\t' read -r domain flag path secure expires name value rest <<<"$line" || __expression_may_fail

		if [[ -z "$domain" || -z "$name" ]]; then
			continue
		fi

		if [[ ! "$expires" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
			expires="-1"
		fi

		json_items+=(
			"$(
				jq --null-input --compact-output \
					--arg name "$name" \
					--arg value "$value" \
					--arg domain "$domain" \
					--arg path "${path:-/}" \
					--arg secure "$secure" \
					--arg expires "$expires" \
					--argjson httpOnly "$http_only" \
					'{
						name: $name,
						value: $value,
						domain: $domain,
						path: ($path | if . == "" then "/" else . end),
						expires: (
							($expires | tonumber | floor) as $exp
							| if $exp > 0 then $exp else -1 end
						),
						httpOnly: $httpOnly,
						secure: (($secure | ascii_upcase) == "TRUE"),
						sameSite: (if ($secure | ascii_upcase) == "TRUE" then "None" else "Lax" end)
					}'
			)"
		)
	done < "$cookie_file"

	if [[ ${#json_items[@]} -eq 0 ]]; then
		__info "No cookies in %s" "$cookie_file"
		return 1
	fi

	printf '%s\n' "${json_items[@]}" | jq --slurp '.'
}

handler_webpage_archive_write_screenshot_with_screenshot_scraper_cookies_to_storage_state() {
	local cookie_file="$1"
	local output_json="$2"
	local cookies
	cookies="$(handler_webpage_archive_write_screenshot_with_screenshot_scraper_twitter_cookies_json "$cookie_file")" || return 55
	jq --null-input --argjson cookies "$cookies" '{cookies: $cookies, origins: []}' >| "$output_json"
}

handler_webpage_archive_write_screenshot_with_screenshot_scraper_require_page_script() {
	if [[ ! -f "$screenshot_page_script" ]]; then
		__info "Missing page script: %s" "$screenshot_page_script"
		return 1
	fi
}

handler_webpage_archive_write_screenshot_with_screenshot_scraper_download() {
	local url="$1"
	local output_directory="$2"
	local status=0
	local maximum_height="$screenshot_maximum_height"

	if [[ -f "$output_directory" ]] && ! $force_update_existing; then
		__verbose "Skipping screenshot %s, file exists" "$output_directory"
		return 0
	fi

	__info "Writing screenshot to: %s" "$output_directory"

	status=0
	handler_webpage_archive_write_screenshot_with_screenshot_scraper_backup_file "$output_directory" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		__warn "screenshot backup failed for %s" "$url"
		return "$status"
	fi
	handler_webpage_archive_write_screenshot_with_screenshot_scraper_require_page_script || return 22

	local work_directory="$temporary_files_path/$(date +%s)-screenshot"
	mkdir --parents -- "$work_directory"
	local auth_file="$work_directory/auth.json"
	local page_script_file="$work_directory/page.js"
	local log_file="$work_directory/shot-scraper.log"

	if ! handler_webpage_archive_write_screenshot_with_screenshot_scraper_cookies_to_storage_state "$screenshot_cookie_file" "$auth_file"; then
		return 21
	fi

	{
		printf 'window.__SCREENSHOT_MAX_HEIGHT__ = %s;\n' "$maximum_height"
		printf 'window.__SCREENSHOT_VIEWPORT_HEIGHT__ = %s;\n' "$screenshot_viewport_height"
		printf 'window.__SCREENSHOT_ZOOM__ = %s;\n' "$screenshot_zoom"
		printf 'window.__SCREENSHOT_REPLY_COUNT__ = %s;\n' "$screenshot_reply_count"
		cat -- "$screenshot_page_script"
	} >| "$page_script_file"

	mkdir --parents -- "$(dirname -- "$output_directory")"
	shot-scraper "$url" --output "$output_directory" --log-console --width "$screenshot_width" --scale-factor "$screenshot_browser_device_pixel_ratio" --format png --auth "$auth_file" --js-file "$page_script_file" --bypass-csp --reduced-motion --timeout 120000 --wait 10000 --wait-for "document.documentElement.getAttribute('data-screenshot-ready') === '1'" >| "$log_file" 2>&1 || status="$(abort_on_interrupt "$?")"
	cat -- "$log_file" >&2

	if grep --quiet 'status of 429' -- "$log_file"; then
		handler_webpage_archive_write_screenshot_with_screenshot_scraper_log_failure "$url" "HTTP 429" "$log_file" "$output_directory"
		__warn "HTTP 429 while screenshotting %s, screenshot file not kept" "$url"
		[[ -f "$output_directory" ]] && rm --force -- "$output_directory"
		return 75
	fi
	if (( status != 0 )); then
		handler_webpage_archive_write_screenshot_with_screenshot_scraper_log_failure "$url" "shot-scraper exit $status" "$log_file" "$output_directory"
		[[ -f "$output_directory" ]] && rm --force -- "$output_directory"
		return "$status"
	fi

	return 0
}

