#!/bin/bash

# configuration start

screenshot_cookie_file="$screenshot_cookie_file"
screenshot_page_script="$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/utilities/screenshot-handler-page.js"
screenshot_maximum_height=16000
screenshot_width="640"
screenshot_viewport_height="800"
screenshot_browser_device_pixel_ratio=4
screenshot_zoom=1
screenshot_reply_count=3

# configuration end

# script task start

handler_screenshot_sourced=true

handler_screenshot_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--screenshot-width" ]]; then
			screenshot_width="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--screenshot-width="* ]]; then
			screenshot_width="${1#--screenshot-width=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--screenshot-maximum-height" ]]; then
			screenshot_maximum_height="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--screenshot-maximum-height="* ]]; then
			screenshot_maximum_height="${1#--screenshot-maximum-height=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--screenshot-reply-count" ]]; then
			screenshot_reply_count="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--screenshot-reply-count="* ]]; then
			screenshot_reply_count="${1#--screenshot-reply-count=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--screenshot-zoom" ]]; then
			screenshot_zoom="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--screenshot-zoom="* ]]; then
			screenshot_zoom="${1#--screenshot-zoom=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--screenshot-scale-factor" ]]; then
			screenshot_browser_device_pixel_ratio="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--screenshot-scale-factor="* ]]; then
			screenshot_browser_device_pixel_ratio="${1#--screenshot-scale-factor=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--screenshot-"* ]]; then
			__error "unknown screenshot argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done
	set -- "${arguments[@]}"
}

handler_screenshot_backup_file() {
	local file="$1"
	[[ -f "$file" ]] || return 0
	local hash ext name dest backup_directory

	hash="$(sha256sum -- "$file" | awk '{print $1}')"
    [[ -n "$hash" ]] || return 1

	ext="${file##*.}"
	name="$hash.$ext.zip"
	backup_directory="$(dirname -- "$(dirname -- "$file")")/__backups"
	mkdir --parents -- "$backup_directory"
	dest="$backup_directory/$name"

	if [[ -f "$dest" ]]; then
		return 0
	fi

	local status=0
	zip --no-wild --junk-paths --test "$dest" "$file" >"/dev/null" || status="$(abort_on_interrupt "$?")"

	if (( status != 0 )); then
		return "$status"
	fi
	__info "Wrote hash backup %s" "$dest"
}

handler_screenshot_twitter_cookies_json() {
	local cookie_file="$1"
	local line rest domain flag path secure expires name value
	local http_only host
	local -a json_items=()

	if [[ ! -f "$cookie_file" ]]; then
		__info "Missing cookie file: %s" "$cookie_file"
		return 1
	fi

	while IFS= read -r line || [[ -n "$line" ]]; do
		http_only=false
		if [[ "$line" == "#HttpOnly_"* ]]; then
			http_only=true
			line="${line#\#HttpOnly_}"
		elif [[ "$line" == \#* || -z "$line" ]]; then
			continue
		fi

		IFS=$'\t' read -r domain flag path secure expires name value rest <<<"$line" || __expression_may_fail
		unset flag rest

		if [[ -z "$domain" || -z "$name" ]]; then
			continue
		fi

		host="${domain#.}"

		if [[ ! "$expires" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
			expires="-1"
		fi

		json_items+=(
			"$(
				jq --null-input --compact-output \
					--arg name "$name" \
					--arg value "$value" \
					--arg domain "$domain" \
					--arg path "${path:-/}" \
					--arg secure "$secure" \
					--arg expires "$expires" \
					--argjson httpOnly "$http_only" \
					'{
						name: $name,
						value: $value,
						domain: $domain,
						path: ($path | if . == "" then "/" else . end),
						expires: (
							($expires | tonumber | floor) as $exp
							| if $exp > 0 then $exp else -1 end
						),
						httpOnly: $httpOnly,
						secure: (($secure | ascii_upcase) == "TRUE"),
						sameSite: (if ($secure | ascii_upcase) == "TRUE" then "None" else "Lax" end)
					}'
			)"
		)
	done < "$cookie_file"

	if [[ ${#json_items[@]} -eq 0 ]]; then
		__info "No cookies in %s" "$cookie_file"
		return 1
	fi

	printf '%s\n' "${json_items[@]}" | jq --slurp '.'
}

handler_screenshot_cookies_to_storage_state() {
	local cookie_file="$1"
	local out_json="$2"
	local cookies

	cookies="$(handler_screenshot_twitter_cookies_json "$cookie_file")" || return 55
	jq --null-input --argjson cookies "$cookies" '{cookies: $cookies, origins: []}' >| "$out_json"
}

handler_screenshot_require_page_script() {
	if [[ ! -f "$screenshot_page_script" ]]; then
		__info "Missing page script: %s" "$screenshot_page_script"
		return 1
	fi
}

handler_screenshot_log_failure() {
	local url="$1" reason="$2" tool_log="$3" json_path
	json_path="$(gallerydl_json_for_url "$url")" || json_path=""
	{
		printf 'url: %s\n' "$url"
		printf 'json: %s\n' "$json_path"
		printf 'reason: %s\n' "$reason"
		printf '%s\n' '--- shot-scraper ---'
		[[ -f "$tool_log" ]] && cat -- "$tool_log"
		printf '\n'
	} >> "$run_error_log"
	if [[ -n "$json_path" ]] && ! grep --quiet --line-regexp --fixed-strings -- "$json_path" "$run_missing_screenshots_log"; then
		printf '%s\n' "$url" >> "$run_missing_screenshots_log"
		printf '%s\n\n' "$json_path" >> "$run_missing_screenshots_log"
	fi
}

handler_make_screenshot_with_shot_scraper() {
	local url="$1"
	local output_directory="$2"
	local auth_file js_file
	local status=0
	local max_h="$screenshot_maximum_height"

	if [[ -f "$output_directory" ]] && ! $force_update_existing; then
		__verbose "Skipping screenshot %s, file exists" "$output_directory"
		return 0
	fi

	__info "Writing screenshot to: %s" "$output_directory"

	handler_screenshot_backup_file "$output_directory" || { __warn "screenshot backup failed for %s" "$url"; return $?; }
	handler_screenshot_require_page_script || return 22

	local work="$temporary_files_path/$(date +%s)-screenshot"
	mkdir --parents -- "$work"
	auth_file="$work/auth.json"
	js_file="$work/page.js"
	local log_file="$work/shot-scraper.log"

	if ! handler_screenshot_cookies_to_storage_state "$screenshot_cookie_file" "$auth_file"; then
		return 21
	fi

	{
		printf 'window.__SCREENSHOT_MAX_HEIGHT__ = %s;\n' "$max_h"
		printf 'window.__SCREENSHOT_VIEWPORT_HEIGHT__ = %s;\n' "$screenshot_viewport_height"
		printf 'window.__SCREENSHOT_ZOOM__ = %s;\n' "$screenshot_zoom"
		printf 'window.__SCREENSHOT_REPLY_COUNT__ = %s;\n' "$screenshot_reply_count"
		cat -- "$screenshot_page_script"
	} >| "$js_file"

	mkdir --parents -- "$(dirname -- "$output_directory")"
	shot-scraper "$url" --output "$output_directory" --log-console --width "$screenshot_width" --scale-factor "$screenshot_browser_device_pixel_ratio" --format png --auth "$auth_file" --js-file "$js_file" --bypass-csp --reduced-motion --timeout 120000 --wait 10000 --wait-for "document.documentElement.getAttribute('data-screenshot-ready') === '1'" >| "$log_file" 2>&1 || status="$(abort_on_interrupt "$?")"
	cat -- "$log_file" >&2


	if grep --quiet 'status of 429' -- "$log_file"; then
		handler_screenshot_log_failure "$url" "HTTP 429" "$log_file"
		__warn "HTTP 429 while screenshotting %s, screenshot file not kept" "$url"
		[[ -f "$output_directory" ]] && rm --force -- "$output_directory"
		return 75
	fi
	if (( status != 0 )); then
		handler_screenshot_log_failure "$url" "shot-scraper exit $status" "$log_file"
		[[ -f "$output_directory" ]] && rm --force -- "$output_directory"
		return "$status"
	fi

	return 0
}
