#!/bin/bash

# configuration start

wget_text_output_as_zip=true

# configuration end

# script task start

handler_wget_text_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--wget-text-argument" ]]; then
			wget_text_arguments+=("${2-}")
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--wget-text-argument="* ]]; then
			wget_text_arguments+=("${1#--wget-text-argument=}")
			shift || __expression_may_fail
		elif [[ "$1" == "--wget-text-arguments-from-file" ]]; then
			wget_text_arguments_file="${2-}"
			[[ -n "$wget_text_arguments_file" ]] || { __error "--wget-text-arguments-from-file requires a path"; local_exit_failsafe; }
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--wget-text-arguments-from-file="* ]]; then
			wget_text_arguments_file="${1#--wget-text-arguments-from-file=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--wget-text-output-as-zip" ]]; then
			wget_text_output_as_zip=true
			shift || __expression_may_fail
		elif [[ "$1" == "--wget-text-output-as-files" ]]; then
			wget_text_output_as_zip=false
			shift || __expression_may_fail
		elif [[ "$1" == "--wget-text-"* ]]; then
			__error "unknown wget-text argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done
	set -- "${arguments[@]}"
}

handler_wget_text_backup() {
	local directory="$1" expected_zip="${2-}"
	[[ -d "$directory" ]] || return 0

	local found=""
	found="$(find "$directory" -mindepth 1 -print -quit)" || return $?
	[[ -n "$found" ]] || return 0

	local backup_dir stamp dest others=false f base
	backup_dir="$(dirname -- "$directory")/__backups"
	[[ "$(basename -- "$directory")" == "__backups" ]] && backup_dir="$(dirname -- "$directory")/../__backups"
	mkdir --parents -- "$backup_dir"
	stamp="$(date +%d-%m-%Y-%H-%M-%S)"
	if [[ -n "$expected_zip" && -f "$expected_zip" ]]; then
		for f in "$directory"/*; do
			[[ -e "$f" ]] || continue
			base="$(basename -- "$f")"
			[[ "$f" == "$expected_zip" || "$f" == "$expected_zip.etag" ]] && continue
			others=true
			break
		done
		if ! $others; then
			dest="$backup_dir/$(basename -- "$expected_zip" .zip)-$stamp.zip"
			local i=1
			while [[ -e "$dest" ]]; do
				dest="$backup_dir/$(basename -- "$expected_zip" .zip)-${stamp}_$i.zip"
				i=$((i + 1))
			done

			mv -- "$expected_zip" "$dest" || return $?
			[[ -f "$expected_zip.etag" ]] && mv -- "$expected_zip.etag" "${dest%.zip}.etag" || return $?

			__info "Moved zip backup %s" "$dest"
			return 0
		fi
		__warn "expected zip %s is mixed with other files; packing the directory" "$expected_zip"
	fi
	dest="$backup_dir/wget-text-$stamp.zip"
	local i=1
	while [[ -e "$dest" ]]; do
		dest="$backup_dir/wget-text-${stamp}_$i.zip"
		i=$((i + 1))
	done
	dest="$(realpath --canonicalize-missing -- "$dest")" || return $?
	__info "Writing backup zip %s" "$dest"
	(cd -- "$directory" && zip --no-wild --test --move "$dest" -- ".") || return $?
}

handler_wget_text_download() {
	local url="$1"
	local domain="$2"
	local output_directory="$3"
	local status=0
	mkdir --parents -- "$(dirname -- "$output_directory")"
	local stem expected_zip work
	stem="$(basename -- "$output_directory")"
	expected_zip="$output_directory"
	if $wget_text_output_as_zip; then
		[[ "$expected_zip" == *.zip ]] || expected_zip="$output_directory.zip"
		if [[ -f "$expected_zip" ]] && ! $force_update_existing; then
			__verbose "Skipping wget-text %s, zip exists" "$url"
			return 0
		fi
		handler_wget_text_backup "$(dirname -- "$expected_zip")" "$expected_zip" || return $?
		work="$temporary_files_path/$(date +%s)-wget-text/$stem"
		mkdir --parents -- "$work"
		output_directory="$work"
	else
		if [[ -d "$output_directory" && -f "$output_directory/SUCCESSFUL_DOWNLOAD" ]] && ! $force_update_existing; then
			__verbose "Skipping wget-text %s, directory exists" "$url"
			return 0
		fi
		handler_wget_text_backup "$output_directory" || return $?
		mkdir --parents -- "$output_directory"
		work="$output_directory"
	fi
	local -a args=()
	local line
	if [[ -n "$wget_text_arguments_file" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			line="${line#"${line%%[![:space:]]*}"}"
			[[ -z "$line" || "$line" == \#* ]] && continue
			args+=("$line")
		done < "$wget_text_arguments_file"
	fi
	args+=("${wget_text_arguments[@]}")
	trap 'handler_wget_text_backup "$work"; exit 130' INT
	trap 'handler_wget_text_backup "$work"; exit 143' TERM
	wget "${args[@]}" --directory-prefix="$output_directory" --domains="$domain" -- "$url" || status=$?
	trap - INT TERM
	if (( status == 130 || status == 143 )); then
		handler_wget_text_backup "$work"
		exit "$status"
	fi
	if (( status != 0 )); then
		handler_wget_text_backup "$work" || return $?
		return "$status"
	fi
	if $wget_text_output_as_zip; then
		mkdir --parents -- "$(dirname -- "$expected_zip")"
		(cd -- "$work" && zip --no-wild --test --move "$expected_zip" -- ".") || return $?
		return 0
	fi
	: >| "$output_directory/SUCCESSFUL_DOWNLOAD"
	return 0
}
