#!/bin/bash

# configuration start

# configuration end

# script start

handler_twitter_archive_export_write_conversation_reconstructed_html_sourced=true

handler_twitter_archive_export_write_conversation_reconstructed_html_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--twitter-archive-export-write-conversation-reconstructed-html-"* ]]; then
			__error "unknown twitter-archive-export-write-conversation-reconstructed-html argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done

	handler_remaining_arguments=("${arguments[@]}")
}

handler_twitter_archive_export_write_conversation_reconstructed_html_log_failure() {
	local url="$1"
	local filename="$2"
	local json_file="$3"
	local reason="$4"
	{
		printf 'url: %s\n' "$url"
		printf 'filename: %s\n' "$filename"
		printf 'json file: %s\n' "$json_file"
		printf 'reason: %s\n' "$reason"
		printf '\n'
	} >> "$run_error_log"
	printf '%s\n%s\n%s\n\n' "# filename=$filename" "# json_file=$json_file" "$url" >> "$run_directory/twitter-archive-export-write-conversation-reconstructed-html-failed-items.log"
}

handler_twitter_archive_export_write_conversation_reconstructed_html_escape() {
	local text="$1"
	text="${text//&/&amp;}"
	text="${text//</&lt;}"
	text="${text//>/&gt;}"
	text="${text//\"/&quot;}"
	printf '%s' "$text"
}

handler_twitter_archive_export_write_conversation_reconstructed_html_media() {
	local directory="$1"
	local output_directory="$2"
	local path
	local suffix
	local source
	local status
	for path in "$directory"/*; do
		[[ -f "$path" ]] || continue

		suffix="${path##*.}"
		suffix="${suffix,,}"
		case "$suffix" in
			"jpg"|"jpeg"|"png"|"webp"|"gif"|"mp4"|"webm") ;;
			*) continue ;;
		esac

		status=0
		source="$(realpath --relative-to="$output_directory" -- "$path")" || status=$?
		if (( status != 0 )); then
			__warn "relative path failed for %s" "$path"
			source="$path"
		fi
		source="$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "$source")"
		case "$suffix" in
			"mp4"|"webm") printf '<video controls src="%s"></video>' "$source" ;;
			*) printf '<img src="%s" alt="">' "$source" ;;
		esac
	done
}

handler_twitter_archive_export_write_conversation_reconstructed_html_render_article() {
	local tweet_id="$1"
	local quoted="${2:-false}"
	local output_directory="$3"
	local json="${json_of["$tweet_id"]}"
	local directory
	directory="$(dirname -- "$json")"
	local text
	text="$(jq -r '.content // .full_text // .text // ""' -- "$json")"
	local kind="tweet"
	[[ "$quoted" == "true" ]] && kind="quote"
	printf '<article class="%s"><header><strong>%s</strong> @%s <time>%s</time></header><p>%s</p>%s' \
		"$kind" \
		"$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "${name_of["$tweet_id"]}")" \
		"$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "${handle_of["$tweet_id"]}")" \
		"$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "${date_of["$tweet_id"]}")" \
		"$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "$text")" \
		"$(handler_twitter_archive_export_write_conversation_reconstructed_html_media "$directory" "$output_directory")"

	local quote_id="${quote_of["$tweet_id"]}"
	if [[ -n "$quote_id" && "$quote_id" != "0" && -n "${json_of["$quote_id"]:-}" ]]; then
		handler_twitter_archive_export_write_conversation_reconstructed_html_render_article "$quote_id" true "$output_directory"
		[[ -n "${embed_only["$quote_id"]:-}" ]] && consumed["$quote_id"]=1
	fi

	printf '</article>'
}

handler_twitter_archive_export_write_conversation_reconstructed_html_render_tree() {
	local tweet_id="$1"
	local output_directory="$2"
	[[ -n "${consumed["$tweet_id"]:-}" ]] && return 0

	handler_twitter_archive_export_write_conversation_reconstructed_html_render_article "$tweet_id" false "$output_directory"
	consumed["$tweet_id"]=1
	if [[ -n "${children_of["$tweet_id"]:-}" ]]; then
		local child
		while IFS= read -r child; do
			[[ -z "$child" ]] && continue
			handler_twitter_archive_export_write_conversation_reconstructed_html_render_tree "$child" "$output_directory"
		done <<< "${children_of["$tweet_id"]}"
	fi
}

handler_twitter_archive_export_write_conversation_reconstructed_html_render_group() {
	local root_id="$1"
	local output="$2"
	local output_directory
	output_directory="$(dirname -- "$output")"
	{
		printf '%s\n' '<!DOCTYPE html><html><head><meta charset="utf-8">'
		printf '<title>%s</title>' "$(handler_twitter_archive_export_write_conversation_reconstructed_html_escape "$root_id")"
		printf '%s\n' '<style>
body{background:#fff;color:#0f1419;font:15px/20px -apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;margin:0}
main{max-width:600px;margin:0 auto;border-left:1px solid #eff3f4;border-right:1px solid #eff3f4}
article{padding:12px 16px;border-bottom:1px solid #eff3f4}
.quote{margin-top:12px;padding:12px;border:1px solid #cfd9de;border-radius:16px}
strong{font-weight:700}
time,article header{color:#536471}
img,video{display:block;max-width:100%;height:auto;margin-top:12px;border-radius:16px}
p{white-space:pre-wrap;margin:4px 0 0}
</style></head><body><main>'
		handler_twitter_archive_export_write_conversation_reconstructed_html_render_tree "$root_id" "$output_directory"
		printf '%s\n' '</main></body></html>'
	} >| "$output"
}

handler_twitter_archive_export_write_conversation_reconstructed_html_manifest_text() {
	local tweet_id="$1"
	local json="${json_of["$tweet_id"]}"
	local mtime
	mtime="$(stat -c "%Y" -- "$json")"
	printf 'json-mtime %s %s\n' "$json" "$mtime"
	local path
	for path in "$(dirname -- "$json")"/*; do
		[[ -f "$path" ]] || continue
		case "${path##*.}" in
			"jpg"|"jpeg"|"png"|"webp"|"gif"|"mp4"|"webm") printf 'sidecar %s\n' "$path" ;;
		esac
	done

	if [[ -n "${children_of["$tweet_id"]:-}" ]]; then
		local child
		while IFS= read -r child; do
			[[ -z "$child" ]] && continue

			handler_twitter_archive_export_write_conversation_reconstructed_html_manifest_text "$child"
		done <<< "${children_of["$tweet_id"]}"
	fi

	if [[ -n "${quote_of["$tweet_id"]:-}" && -n "${json_of["${quote_of["$tweet_id"]}"]:-}" ]]; then
		handler_twitter_archive_export_write_conversation_reconstructed_html_manifest_text "${quote_of["$tweet_id"]}"
	fi
}

handler_twitter_archive_export_write_conversation_reconstructed_html_backup() {
	local output="$1"
	local manifest="$2"
	[[ ! -f "$output" && ! -f "$manifest" ]] && return 0

	local backup_directory
	backup_directory="$(backup_directory_for "$output" "$(handler_base_path "twitter-archive-export-write-conversation-reconstructed-html")" "${handler_leaf_name["twitter-archive-export-write-conversation-reconstructed-html"]-}")"

	mkdir --parents -- "$backup_directory"
	local mtime
	if [[ -f "$output" ]]; then
		mtime="$(date -r "$output" "+%d-%m-%Y-%H-%M-%S")" || return $?
	else
		mtime="$(date "+%d-%m-%Y-%H-%M-%S")"
	fi
	local dest="$backup_directory/json-to-html-$mtime.zip"
	local i=1
	while [[ -e "$dest" ]]; do
		dest="$backup_directory/json-to-html-${mtime}_$i.zip"
		i="$((i + 1))" || __expression_may_fail
	done
	dest="$(realpath --canonicalize-missing -- "$dest")"
	local -a files=()
	[[ -f "$output" ]] && files+=("$output")
	[[ -f "$manifest" ]] && files+=("$manifest")
	zip --no-wild --junk-paths --test "$dest" "${files[@]}" >"/dev/null" || return $?
	__info "Wrote pair backup %s" "$dest"
}

handler_twitter_archive_export_write_conversation_reconstructed_html_reconstruct() {
	declare -A json_of=()
	declare -A reply_of=()
	declare -A quote_of=()
	declare -A name_of=()
	declare -A handle_of=()
	declare -A date_of=()
	declare -A children_of=()
	declare -A consumed=()
	declare -A embed_only=()
	declare -A quoted_entry=()

	local key
	for key in "${tree_order[@]}"; do
		local -a local_jsons=()
		mapfile -t local_jsons < <(get_values "$key" "local" true)
		local quoted_flag=""
		quoted_flag="$(get_value "$key" "is_quoted_tweet" 2>"/dev/null")" || quoted_flag=""
		local local_json
		for local_json in "${local_jsons[@]}"; do
			[[ -z "$local_json" || ! -f "$local_json" ]] && continue
			[[ "$local_json" == *".json" || "$local_json" == *".JSON" ]] || continue

			local tweet_id
			tweet_id="$(jq -r '.tweet_id // .id // empty | tostring' -- "$local_json")"
			[[ -n "$tweet_id" ]] || tweet_id="$(basename -- "$(dirname -- "$local_json")")"

			local reply_id
			reply_id="$(jq -r '.reply_id // empty | tostring' -- "$local_json")"
			[[ "$reply_id" == "0" || "$reply_id" == "null" ]] && reply_id=""

			local quote_id
			quote_id="$(jq -r '.quoted_id // empty | tostring' -- "$local_json")"
			[[ "$quote_id" == "0" || "$quote_id" == "null" ]] && quote_id=""

			local name
			name="$(jq -r '.author.name // .user.name // .author.nick // empty' -- "$local_json")"
			local handle
			handle="$(jq -r '.author.screen_name // .user.screen_name // .author.name // empty' -- "$local_json")"
			local date
			date="$(jq -r '.date // empty' -- "$local_json")"

			json_of["$tweet_id"]="$local_json"
			reply_of["$tweet_id"]="$reply_id"
			quote_of["$tweet_id"]="$quote_id"
			name_of["$tweet_id"]="$name"
			handle_of["$tweet_id"]="$handle"
			date_of["$tweet_id"]="$date"

			[[ "$quoted_flag" == "true" ]] && quoted_entry["$tweet_id"]=1
		done
	done

	local tweet_id
	for tweet_id in "${!quote_of[@]}"; do
		local quote_id="${quote_of["$tweet_id"]}"
		[[ -n "$quote_id" && -z "${json_of["$quote_id"]:-}" ]] || continue
		local found

		local leaf="${handler_leaf_name["twitter-archive-write-tweet-with-gallerydl"]-}"
		local quote_glob="$quote_id/$reserved_data_name"
		[[ -n "$leaf" ]] && quote_glob+="/$leaf"
		for found in "$gallerydl_dump_path/$reserved_children_name/$reserved_nodes_name"/*/"$quote_glob/$quote_id.json"; do
			[[ -f "$found" ]] || continue
			json_of["$quote_id"]="$found"
			embed_only["$quote_id"]=1
			name_of["$quote_id"]="$(jq -r '.author.name // .user.name // empty' -- "$found")"
			handle_of["$quote_id"]="$(jq -r '.author.screen_name // .user.screen_name // .author.name // empty' -- "$found")"
			date_of["$quote_id"]="$(jq -r '.date // empty' -- "$found")"

			break
		done
	done

	for tweet_id in "${!reply_of[@]}"; do
		local parent="${reply_of["$tweet_id"]}"
		[[ -n "$parent" && -n "${json_of["$parent"]:-}" && -z "${embed_only["$tweet_id"]:-}" ]] || continue
		children_of["$parent"]+="$tweet_id"$'\n'
	done

	for tweet_id in $(printf '%s\n' "${!json_of[@]}" | sort); do
		[[ -n "${embed_only["$tweet_id"]:-}" ]] && continue

		local parent="${reply_of["$tweet_id"]}"
		[[ -n "$parent" && -n "${json_of["$parent"]:-}" ]] && continue
		[[ -n "${consumed["$tweet_id"]:-}" ]] && continue

		local json="${json_of["$tweet_id"]}"
		[[ -n "${quoted_entry["$tweet_id"]:-}" ]] && continue

		local tweet_directory
		tweet_directory="$(dirname -- "$json")"

		local data_directory
		data_directory="$(dirname -- "$json")"
		while [[ "$(basename -- "$data_directory")" != "$reserved_data_name" && "$data_directory" != "/" ]]; do
			data_directory="$(dirname -- "$data_directory")"
		done
		local tweet_id_directory
		tweet_id_directory="$(dirname -- "$data_directory")"
		local user_id
		user_id="$(basename -- "$(dirname -- "$tweet_id_directory")")"
		local output_directory
		output_directory="$(handler_leaf_directory "twitter-archive-export-write-conversation-reconstructed-html" "$user_id/$(basename -- "$tweet_id_directory")")"


		local output="$output_directory/reconstructed-twitter-thread.html"
		local manifest="$output_directory/reconstructed-twitter-thread.manifest"
		mkdir --parents -- "$output_directory"

		local current
		current="$(handler_twitter_archive_export_write_conversation_reconstructed_html_manifest_text "$tweet_id" | sort)"
		if [[ -f "$output" && -f "$manifest" ]] && ! $force_update_existing; then
			if [[ "$(sort -- "$manifest")" == "$current" ]]; then
				__verbose "Skipping reconstructed thread %s, manifest matches" "$output"
				consumed["$tweet_id"]=1
				continue
			fi
		fi

		local next_manifest
		next_manifest="$(mktemp)"
		printf '%s\n' "$current" >| "$next_manifest"
		handler_twitter_archive_export_write_conversation_reconstructed_html_backup "$output" "$manifest"
		handler_twitter_archive_export_write_conversation_reconstructed_html_render_group "$tweet_id" "$output"
		if [[ ! -f "$output" ]]; then
			local tweet_url
			tweet_url="$(jq -r '.url // .tweet_url // empty' -- "$json")"
			[[ -n "$tweet_url" ]] || tweet_url="tweet $tweet_id"
			handler_twitter_archive_export_write_conversation_reconstructed_html_log_failure "$tweet_url" "$output" "$json" "render produced no file"
			__warn "json-to-html failed for %s" "$tweet_url"
			continue
		fi
		mv -f -- "$next_manifest" "$manifest"
		__info "Wrote reconstructed thread %s" "$output"
	done
}
