handler_json_to_html_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--json-to-html-"* ]]; then
			__error "unknown json-to-html argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done
	set -- "${arguments[@]}"
}

handler_json_to_html_escape() {
	local text="$1"
	text="${text//&/&amp;}"
	text="${text//</&lt;}"
	text="${text//>/&gt;}"
	text="${text//\"/&quot;}"
	printf '%s' "$text"
}

handler_json_to_html_media() {
	local dir="$1" out_dir="$2" path suffix source
	for path in "$dir"/*; do
		[[ -f "$path" ]] || continue
		suffix="${path##*.}"
		suffix="${suffix,,}"
		case "$suffix" in
			jpg|jpeg|png|webp|gif|mp4|webm) ;;
			*) continue ;;
		esac
		source="$(realpath --relative-to="$out_dir" -- "$path")" || { __warn "relative path failed for %s" "$path"; source="$path"; }
		source="$(handler_json_to_html_escape "$source")"
		case "$suffix" in
			mp4|webm) printf '<video controls src="%s"></video>' "$source" ;;
			*) printf '<img src="%s" alt="">' "$source" ;;
		esac
	done
}

handler_json_to_html_render_article() {
	local tweet_id="$1" quoted="${2:-false}" out_dir="$3"
	local json dir text quote_id kind="tweet"
	json="${json_of[$tweet_id]}"
	dir="$(dirname -- "$json")"
	text="$(jq -r '.content // .full_text // .text // ""' -- "$json")"
	[[ "$quoted" == true ]] && kind="quote"
	printf '<article class="%s"><header><strong>%s</strong> @%s <time>%s</time></header><p>%s</p>%s' \
		"$kind" \
		"$(handler_json_to_html_escape "${name_of[$tweet_id]}")" \
		"$(handler_json_to_html_escape "${handle_of[$tweet_id]}")" \
		"$(handler_json_to_html_escape "${date_of[$tweet_id]}")" \
		"$(handler_json_to_html_escape "$text")" \
		"$(handler_json_to_html_media "$dir" "$out_dir")"
	quote_id="${quote_of[$tweet_id]}"
	if [[ -n "$quote_id" && -n "${json_of[$quote_id]:-}" ]]; then
		handler_json_to_html_render_article "$quote_id" true "$out_dir"
		consumed["$quote_id"]=1
	fi
	printf '</article>'
}

handler_json_to_html_render_tree() {
	local tweet_id="$1" out_dir="$2" child
	[[ -n "${consumed[$tweet_id]:-}" ]] && return 0
	handler_json_to_html_render_article "$tweet_id" false "$out_dir"
	consumed["$tweet_id"]=1
	if [[ -n "${children_of[$tweet_id]:-}" ]]; then
		while IFS= read -r child; do
			[[ -n "$child" ]] || continue
			handler_json_to_html_render_tree "$child" "$out_dir"
		done <<< "${children_of[$tweet_id]}"
	fi
}

handler_json_to_html_render_group() {
	local root_id="$1" output="$2" out_dir
	out_dir="$(dirname -- "$output")"
	{
		printf '%s\n' '<!DOCTYPE html><html><head><meta charset="utf-8">'
		printf '<title>%s</title>' "$(handler_json_to_html_escape "$root_id")"
		printf '%s\n' '<style>
body{background:#fff;color:#0f1419;font:15px/20px -apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;margin:0}
main{max-width:600px;margin:0 auto;border-left:1px solid #eff3f4;border-right:1px solid #eff3f4}
article{padding:12px 16px;border-bottom:1px solid #eff3f4}
.quote{margin-top:12px;padding:12px;border:1px solid #cfd9de;border-radius:16px}
strong{font-weight:700}
time,article header{color:#536471}
img,video{display:block;max-width:100%;height:auto;margin-top:12px;border-radius:16px}
p{white-space:pre-wrap;margin:4px 0 0}
</style></head><body><main>'
		handler_json_to_html_render_tree "$root_id" "$out_dir"
		printf '%s\n' '</main></body></html>'
	} > "$output"
}

handler_json_to_html_manifest_text() {
	local tweet_id="$1" json path mtime
	json="${json_of[$tweet_id]}"
	mtime="$(stat -c %Y -- "$json")"
	printf 'json-mtime %s %s\n' "$json" "$mtime"
	for path in "$(dirname -- "$json")"/*; do
		[[ -f "$path" ]] || continue
		case "${path##*.}" in
			jpg|jpeg|png|webp|gif|mp4|webm) printf 'sidecar %s\n' "$path" ;;
		esac
	done
	if [[ -n "${children_of[$tweet_id]:-}" ]]; then
		local child
		while IFS= read -r child; do
			[[ -n "$child" ]] || continue
			handler_json_to_html_manifest_text "$child"
		done <<< "${children_of[$tweet_id]}"
	fi
}

handler_json_to_html_backup() {
	local output="$1" manifest="$2"
	[[ -f "$output" || -f "$manifest" ]] || return 0
	local backup_dir mtime dest
	backup_dir="$(dirname -- "$output")/../__backups"
	mkdir --parents -- "$backup_dir"
	if [[ -f "$output" ]]; then
		mtime="$(date -r "$output" +%d-%m-%Y-%H-%M-%S)" || return $?
	else
		mtime="$(date +%d-%m-%Y-%H-%M-%S)"
	fi
	dest="$backup_dir/json-to-html-$mtime.zip"
	local i=1
	while [[ -e "$dest" ]]; do
		dest="$backup_dir/json-to-html-${mtime}_$i.zip"
		i=$((i + 1))
	done
	dest="$(realpath --canonicalize-missing -- "$dest")"
	local -a files=()
	[[ -f "$output" ]] && files+=("$output")
	[[ -f "$manifest" ]] && files+=("$manifest")
	zip --no-wild --junk-paths --test "$dest" "${files[@]}" >"/dev/null" || return $?
	__info "Wrote pair backup %s" "$dest"
}

handler_json_to_html_reconstruct() {
	local key local_json tweet_id reply_id quote_id name handle date json parent root_id
	local output manifest out_dir user_id current next_manifest
	declare -A json_of=() reply_of=() quote_of=() name_of=() handle_of=() date_of=()
	declare -A children_of=() consumed=() embed_only=()

	declare -A quoted_entry=()
	for key in "${tree_order[@]}"; do
		local -a local_jsons=()
		mapfile -t local_jsons < <(get_values "$key" "local" true)
		local quoted_flag=""
		quoted_flag="$(get_value "$key" "is_quoted_tweet" 2>"/dev/null" )" || value=""
		for local_json in "${local_jsons[@]}"; do
		[[ -n "$local_json" && -f "$local_json" ]] || continue
		[[ "$local_json" == *.json || "$local_json" == *.JSON ]] || continue
		tweet_id="$(jq -r '.tweet_id // .id // empty | tostring' -- "$local_json")"
		[[ -n "$tweet_id" ]] || tweet_id="$(basename -- "$(dirname -- "$local_json")")"
		reply_id="$(jq -r '.reply_id // empty | tostring' -- "$local_json")"
		quote_id="$(jq -r '.quote_id // empty | tostring' -- "$local_json")"
		name="$(jq -r '.author.name // .user.name // .author.nick // empty' -- "$local_json")"
		handle="$(jq -r '.author.screen_name // .user.screen_name // .author.name // empty' -- "$local_json")"
		date="$(jq -r '.date // empty' -- "$local_json")"
		json_of["$tweet_id"]="$local_json"
		reply_of["$tweet_id"]="$reply_id"
		quote_of["$tweet_id"]="$quote_id"
		name_of["$tweet_id"]="$name"
		handle_of["$tweet_id"]="$handle"
		date_of["$tweet_id"]="$date"
		[[ "$quoted_flag" == "true" ]] && quoted_entry["$tweet_id"]=1
		done
	done

	for tweet_id in "${!quote_of[@]}"; do
		quote_id="${quote_of[$tweet_id]}"
		[[ -n "$quote_id" && -z "${json_of[$quote_id]:-}" ]] || continue
		local found=""
		for found in "$gallerydl_dump_path"/*/"$quote_id"/"$quote_id.json"; do
			[[ -f "$found" ]] || continue
			json_of["$quote_id"]="$found"
			embed_only["$quote_id"]=1
			name_of["$quote_id"]="$(jq -r '.author.name // .user.name // empty' -- "$found")"
			handle_of["$quote_id"]="$(jq -r '.author.screen_name // .user.screen_name // .author.name // empty' -- "$found")"
			date_of["$quote_id"]="$(jq -r '.date // empty' -- "$found")"
			break
		done
	done

	for tweet_id in "${!reply_of[@]}"; do
		parent="${reply_of[$tweet_id]}"
		[[ -n "$parent" && -n "${json_of[$parent]:-}" && -z "${embed_only[$tweet_id]:-}" ]] || continue
		children_of["$parent"]+="$tweet_id"$'\n'
	done

	for tweet_id in $(printf '%s\n' "${!json_of[@]}" | sort); do
		[[ -n "${embed_only[$tweet_id]:-}" ]] && continue
		parent="${reply_of[$tweet_id]}"
		[[ -n "$parent" && -n "${json_of[$parent]:-}" ]] && continue
		[[ -n "${consumed[$tweet_id]:-}" ]] && continue
		json="${json_of[$tweet_id]}"
		[[ -n "${quoted_entry[$tweet_id]:-}" ]] && continue
		local tweet_dir
		tweet_dir="$(dirname -- "$json")"
		user_id="$(basename -- "$(dirname -- "$tweet_dir")")"
		out_dir="$(handler_leaf_dir json-to-html "$user_id/$(basename -- "$tweet_dir")")"
		output="$out_dir/reconstructed-twitter-thread.html"
		manifest="$out_dir/reconstructed-twitter-thread.manifest"
		mkdir --parents -- "$out_dir"
		current="$(handler_json_to_html_manifest_text "$tweet_id" | sort)"
		if [[ -f "$output" && -f "$manifest" ]] && ! $force_update_existing; then
			if [[ "$(sort -- "$manifest")" == "$current" ]]; then
				__verbose "Skipping reconstructed thread %s, manifest matches" "$output"
				consumed["$tweet_id"]=1
				continue
			fi
		fi
		next_manifest="$(mktemp)"
		printf '%s\n' "$current" >| "$next_manifest"
		handler_json_to_html_backup "$output" "$manifest"
		handler_json_to_html_render_group "$tweet_id" "$output"
		mv -f -- "$next_manifest" "$manifest"
		__info "Wrote reconstructed thread %s" "$output"
	done
}
