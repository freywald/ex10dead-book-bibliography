#!/bin/bash

# configuration start

# configuration end

# script start

handler_twitter_archive_write_tweet_with_gallerydl_sourced=true

handler_twitter_archive_write_tweet_with_gallerydl_parse_arguments() {
	local -a arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--twitter-archive-write-tweet-with-gallerydl-sleep" ]]; then
			gallerydl_sleep="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--twitter-archive-write-tweet-with-gallerydl-sleep="* ]]; then
			gallerydl_sleep="${1#--twitter-archive-write-tweet-with-gallerydl-sleep=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--twitter-archive-write-tweet-with-gallerydl-sleep-request" ]]; then
			gallerydl_sleep_request="${2-}"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--twitter-archive-write-tweet-with-gallerydl-sleep-request="* ]]; then
			gallerydl_sleep_request="${1#--twitter-archive-write-tweet-with-gallerydl-sleep-request=}"
			shift || __expression_may_fail
		elif [[ "$1" == "--twitter-archive-write-tweet-with-gallerydl-"* ]]; then
			__error "unknown twitter-archive-write-tweet-with-gallerydl argument %s" "$1"
			local_exit_failsafe
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done

	handler_remaining_arguments=("${arguments[@]}")
}

handler_twitter_archive_write_tweet_with_gallerydl_log_failure() {
	local url="$1"
	local filename="$2"
	local reason="$3"
	{
		printf 'url: %s\n' "$url"
		printf 'filename: %s\n' "$filename"
		printf 'reason: %s\n' "$reason"
		printf '\n'
	} >> "$run_error_log"
	printf '%s\n%s\n\n' "# filename=$filename" "$url" >> "$run_directory/twitter-archive-write-tweet-with-gallerydl-failed-items.log"
}

handler_twitter_archive_write_tweet_with_gallerydl_tweet_complete() {
	local directory="$1"
	local json="$2"
	if [[ ! -f "$json" ]]; then
		return 1
	fi

	local tweet_id
	tweet_id="$(basename -- "$json" .json)"

	local f
	for f in "$directory"/*.part "$directory"/*.part.*; do
		if [[ -e "$f" ]]; then
			return 1
		fi
	done

	local status=0
	local media_count
	media_count="$(jq -r '
		(.extended_entities.media // .entities.media // .media // [])
		| if type == "array" then . else [] end
		| map(select(type == "object" and (.type == "photo" or .type == "video" or .type == "animated_gif" or .type == "image")))
		| unique_by(.id_str // .media_key // .media_url_https // .url)
		| length
	' -- "$json")" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		return "$status"
	fi

	media_count="${media_count:-0}"
	if [[ ! "$media_count" =~ ^[0-9]+$ ]]; then
		media_count=0
	fi
	if (( media_count == 0 )); then
		return 0
	fi

	local files=0
	for f in "$directory/${tweet_id}_"*; do
		if [[ ! -f "$f" ]]; then
			continue
		fi
		case "$f" in
			*.part|*.part.*) continue ;;
		esac
		files="$((files + 1))" || __expression_may_fail
	done

	(( files >= media_count ))
}

handler_twitter_archive_write_tweet_with_gallerydl_backup_file() {
	local file="$1"
	local backup_directory="$2"
	if [[ ! -f "$file" ]]; then
		return 0
	fi

	local status=0
	local hash
	hash="$(sha256sum -- "$file" | awk '{print $1}')" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		return "$status"
	fi
	if [[ -z "$hash" ]]; then
		return 1
	fi

	local ext="${file##*.}"
	local name="$hash.$ext.zip"
	mkdir --parents -- "$backup_directory"
	local dest="$backup_directory/$name"
	if [[ -f "$dest" ]]; then
		return 0
	fi

	status=0
	zip --no-wild --junk-paths --test "$dest" "$file" >"/dev/null" || status="$(abort_on_interrupt "$?")"
	if (( status != 0 )); then
		return "$status"
	fi
	if [[ ! -f "$dest" ]]; then
		return 1
	fi

	__info "Wrote hash backup %s" "$dest"
}

handler_twitter_archive_write_tweet_with_gallerydl_backup_leaf() {
	local directory="$1"
	if [[ ! -d "$directory" ]]; then
		return 0
	fi

	local backup_directory
	backup_directory="$(backup_directory_for "$directory" "$(handler_base_path "twitter-archive-write-tweet-with-gallerydl")" "${handler_leaf_name["twitter-archive-write-tweet-with-gallerydl"]-}")"

	mkdir --parents -- "$backup_directory"
	local file
	for file in "$directory"/*; do
		if [[ ! -f "$file" ]]; then
			continue
		fi
		case "$file" in
			*.part|*.part.*) continue ;;
		esac
		handler_twitter_archive_write_tweet_with_gallerydl_backup_file "$file" "$backup_directory" || return $?
	done
}

handler_twitter_archive_write_tweet_with_gallerydl_is_status_url() {
	local url="$1"
	local host="${url#*://}"
	host="${host%%/*}"
	host="${host#www.}"
	host="${host,,}"
	if [[ "$host" != "x.com" && "$host" != "twitter.com" ]]; then
		return 1
	fi
	[[ -n "$(twitter_status_id "$url")" ]]
}

function handler_twitter_archive_write_tweet_with_gallerydl_download() {
	local url="$1"

	if ! handler_twitter_archive_write_tweet_with_gallerydl_is_status_url "$url"; then
		__warn "method twitter-archive-write-tweet-with-gallerydl is skipped, not an X status URL: %s" "$url"
		return 0
	fi

	local json
	json="$(gallerydl_json_for_url "$url")" || json=""
	local tweet_directory
	if [[ -n "$json" && -f "$json" ]]; then
		tweet_directory="$(dirname -- "$json")"
		if handler_twitter_archive_write_tweet_with_gallerydl_tweet_complete "$tweet_directory" "$json" && ! $force_update_existing; then
			__verbose "gallery-dl skipped, files complete"
			return 0
		fi
	fi

	local id_path="${queued_ids["$url"]-}"
	if [[ -n "$id_path" ]]; then
		tweet_directory="$(handler_leaf_directory "twitter-archive-write-tweet-with-gallerydl" "$id_path")"
		handler_twitter_archive_write_tweet_with_gallerydl_backup_leaf "$tweet_directory" || {
			__warn "gallery-dl backup failed for %s" "$url"
			return $?
		}
	fi
	mkdir --parents -- "$gallerydl_dump_path"

	__info "Downloading gallery-dl %s" "$url"

	local part_directory="$temporary_files_path/$(date +%s)-gallery-dl"
	mkdir --parents -- "$part_directory"

	local leaf="${handler_leaf_name["twitter-archive-write-tweet-with-gallerydl"]-}"
	local -a gallerydl_directory=("$reserved_children_name" "$reserved_nodes_name" "{author[id]|user[id]}" "{tweet_id}" "$reserved_data_name")
	[[ -n "$leaf" ]] && gallerydl_directory+=("$leaf")
	local gallerydl_directory_json
	gallerydl_directory_json="$(printf '%s\n' "${gallerydl_directory[@]}" | jq -Rsc 'split("\n")[:-1]')"

	local status=0
	gallery-dl --verbose --config-ignore --cookies "$gallery_dl_cookie_file" --mtime-from-date --sleep "${gallerydl_sleep:-20-60}" --sleep-request "${gallerydl_sleep_request:-30-90}" --retries 6 --http-timeout 60.0 --limit-rate 5M --option downloader.mtime=false --option downloader.progress=5.0 --option downloader.part-directory="$part_directory" --option downloader.timeout=60.0 --option downloader.ytdl.module=yt_dlp --option extractor.base-directory="$gallerydl_dump_path/" --option extractor.path-restrict='{"\\":"⧹","/":"⧸","|":"￨",":":"꞉","*":"∗","?":"？","\"":"″","<":"﹤",">":"﹥"}' --option extractor.ytdl.enabled=true --option extractor.ytdl.module=yt_dlp --option extractor.ytdl.generic=false --option extractor.ytdl.config-file="$HOME/.config/yt-dlp/config" --option extractor.twitter.quoted=true --option extractor.twitter.unavailable=true --option extractor.twitter.cards=true --option extractor.twitter.retweets=true --option extractor.twitter.size=orig --option extractor.twitter.text-tweets=true --option extractor.twitter.twitpic=true --option extractor.twitter.directory="$gallerydl_directory_json" --postprocessor metadata --postprocessor-option event=post --postprocessor-option filename="{tweet_id}.json" -- "$url" || status="$(abort_on_interrupt "$?")"

	if (( status > 0 )); then
		local logged_file="${json:-$tweet_directory}"
		handler_twitter_archive_write_tweet_with_gallerydl_log_failure "$url" "$logged_file" "gallery-dl exit $status"
	fi

	return "$status"
}
