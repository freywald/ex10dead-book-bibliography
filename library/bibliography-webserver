#!/bin/bash

LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH="Build/libraries/ex10dead-book-bibliography/" # @todo set from outside
LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH="Build/libraries/" # @todo set from outside

source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format" || exit 1
source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format.bibliography" || exit 1
source -- "./$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/utilities/load-configuration" || exit 1

# configuration start

python_webserver_library_path="$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/webserver/server.py"

# configuration end

# script task start

pick_and_serve_zip() {
	local serve="$1"
	local label="${2-}"

	if [[ ! -f "$serve" ]]; then
		__error "archive not found: %s" "$serve"
		local_exit_failsafe
	fi

	__heading "Starting webserver for %s…" "${label:-$found_url}"
	__info "Please open any web browser of your liking and navigate to address %s" "http://127.0.0.1:8080"
	echo

	python3 "$python_webserver_library_path" --directory "$serve" --port "8080" --host "127.0.0.1" "${configuration_arguments[@]}"
}

function bibliography_webserver() {
	walk_archive=false
	show_extras=false
	configuration_files=()

	arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--debug" ]]; then
			__debug=true
			shift || __expression_may_fail
		elif [[ "$1" == "--verbose" ]]; then
			__verbose=true
			shift || __expression_may_fail
		elif [[ "$1" == "--quiet" ]]; then
			__quiet=true
			shift || __expression_may_fail
		elif [[ "$1" == "--walk-archive" || "$1" == "--all" ]]; then
			walk_archive=true
			shift || __expression_may_fail
		elif [[ "$1" == "--configuration-file" ]]; then
			[[ -n "${2-}" ]] || { __error "--configuration-file requires a path"; local_exit_failsafe; }
			configuration_files+=("$2")
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--configuration-file="* ]]; then
			[[ -n "${1#--configuration-file=}" ]] || { __error "--configuration-file requires a path"; local_exit_failsafe; }
			configuration_files+=("${1#--configuration-file=}")
			shift || __expression_may_fail
		elif [[ "$1" == "--extras" ]]; then
			show_extras=true
			arguments+=("$1")
			shift || __expression_may_fail
		else
			arguments+=("$1")
			shift || __expression_may_fail
		fi
	done
	set -- "${arguments[@]}"

	declare -gA handler_enabled=()
	declare -gA handler_output_path=()
	declare -gA handler_leaf_name=()

	local default_configuration_file="$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/configuration/defaults.yaml"
	[[ ! -f "$default_configuration_file" ]] && { __error "default configuration file not found: %s" "$default_configuration_file"; local_exit_failsafe; }

	__verbose "loading configuration file %s" "$default_configuration_file"
	load_configuration_file "$default_configuration_file"

	local configuration_file
	for configuration_file in "${configuration_files[@]}"; do
		__verbose "loading configuration file %s" "$configuration_file"
		[[ ! -f "$configuration_file" ]] && { __error "configuration file %s does not exist" "$configuration_file"; local_exit_failsafe; }
		load_configuration_file "$configuration_file"
	done

	[[ -n "$archive_path" ]] || { __error "archive_path is required"; local_exit_failsafe; }
	[[ -n "$bibliography_name" ]] || { __error "bibliography_name is required"; local_exit_failsafe; }
	[[ -n "$bibliography_sources_path" ]] || { __error "bibliography_sources_path is required"; local_exit_failsafe; }

	given_url_identifier="${1-}"
	if [[ -z "$given_url_identifier" ]]; then
		 walk_archive=true
	fi

	__info "[%s] building web link🌲︎…" "__$__current_script_name"

	#archive_path="$(__right_normalize_absolute_path "$archive_path/")"

	__heading "Parsing sources"
	__info "Parsing path %s…" "$bibliography_sources_path"
	parse_sources_path "$bibliography_sources_path" -1 --new-line-format || __failure "Parsing failed!"
	if ! validate_tree; then
		__failure "Validating sources failed!"
		__error "Tree validation failed!"
		local_exit_failsafe
	fi

	__success "Parsing completed."

	generate_tree
	verify_tree || __failure "Tree verification failed!"

	if $walk_archive; then
		__heading "Starting webserver for the whole archive…"
		python3 "$python_webserver_library_path" --archive-root "$archive_path" --port "8080" --host "127.0.0.1" "${configuration_arguments[@]}"
		exit 0
	fi

	given_url_identifier="${1-}"
	if [[ -z "$given_url_identifier" ]]; then
		__error "usage: %s <TITLE-ID> [--extras]" "$__current_script_name"
		local_exit_failsafe
	fi

	index=""
	if ! index="$(get_entry_index_by_keyvalue "_id" "$given_url_identifier")"; then
		echo "ERROR: id '$given_url_identifier' cannot be found" >&2
		exit 1
	fi

	found_url="$(get_value "$index" "_")"
	found_url="${found_url-}"

	entry_zip="$archive_path/$given_url_identifier.zip"
	work_directory="$archive_path/$given_url_identifier"

	extra_zips=( "$work_directory"/*.zip )

	declare -a configuration_arguments=()
	for configuration_file in "${configuration_files[@]}"; do
		configuration_arguments+=(--configuration-file "$configuration_file")
	done

	if ! $show_extras; then
		if [[ ! -f "$entry_zip" ]]; then
			if (( ${#extra_zips[@]} > 0 )); then
				__info "extras exist; run: %s %s --extras" "$__current_script_name" "$given_url_identifier"
			fi
			__error "no entry zip for id %s at %s" "$given_url_identifier" "$entry_zip"
			local_exit_failsafe
		fi
		pick_and_serve_zip "$entry_zip" "$found_url"
	else
		menu_paths=()
		menu_labels=()

		if [[ -f "$entry_zip" ]]; then
			menu_paths+=("$entry_zip")
			menu_labels+=("main entry  $(basename -- "$entry_zip")")
		fi

		for extra in "${extra_zips[@]+"${extra_zips[@]}"}"; do
			menu_paths+=("$extra")
			menu_labels+=("extra       $(basename -- "$extra")")
		done

		if (( ${#menu_paths[@]} == 0 )); then
			__error "no zips for id %s" "$given_url_identifier"
			local_exit_failsafe
		fi

		while true; do
			echo
			__heading "Archives for %s" "$given_url_identifier"
			i=0
			for ((i = 0; i < ${#menu_paths[@]}; i++)); do
				printf "  %2d  %s\n" "$((i + 1))" "${menu_labels[$i]}"
			done
			echo

			choice=""
			read -r -p "Number (1-${#menu_paths[@]}): " choice || choice=""
			echo

			if ! [[ "$choice" =~ ^[1-9][0-9]*$ ]] || (( choice < 1 || choice > ${#menu_paths[@]} )); then
				__warn "invalid selection"
				continue
			fi

			selected="${menu_paths[choice - 1]}"
			selected_label="${menu_labels[choice - 1]}"
			if __confirm "Open ${selected_label} ?"; then
				pick_and_serve_zip "$selected" "$selected_label"
				break
			fi
			__info "choose another zip, or the main entry"
		done
	fi

	echo
	__info "[%s] done." "__$__current_script_name"
}
