		fi
	done

	set -- "${handler_arguments[@]}"

	if [[ -n "$archive_url_filter" && -z "$filter_by_id" ]]; then
		__error "a url argument requires --archive-id /$archive_url_filter/"
		local_exit_failsafe
	fi

	if [[ "$filter_by_id" != http://* && "$filter_by_id" != https://* && "$filter_by_id" == */ ]]; then
		archive_id_with_extras=true
		filter_by_id="${filter_by_id%/}"
	fi

	if [[ -n "$archive_url_filter" ]]; then
		archive_id_with_extras=true
	fi

	declare -A wget_zip_paths_this_session=()
	declare -A expected_archive_paths=()

	local default_configuration_file="$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/configuration/defaults.yaml"
	[[ ! -f "$default_configuration_file" ]] && { __error "default configuration file not found: %s" "$default_configuration_file"; local_exit_failsafe; }

	__verbose "loading configuration file %s" "$default_configuration_file"
	load_configuration_file "$default_configuration_file"

	local configuration_file
	for configuration_file in "${configuration_files[@]}"; do
		__verbose "loading configuration file %s" "$configuration_file"
		[[ ! -f "$configuration_file" ]] && { __error "configuration file %s does not exist" "$configuration_file"; local_exit_failsafe; }
		load_configuration_file "$configuration_file"
	done

	[[ -n "$archive_path" ]] || { __error "archive_path is required"; local_exit_failsafe; }
	[[ -n "$bibliography_name" ]] || { __error "bibliography_name is required"; local_exit_failsafe; }
	[[ -n "$bibliography_sources_path" ]] || { __error "bibliography_sources_path is required"; local_exit_failsafe; }

	apply_configuration_enables

	$archive_run_gallerydl && handler_gallerydl_parse_arguments
	$archive_run_wget_text && handler_wget_text_parse_arguments
	$archive_run_wget && handler_wget_parse_arguments
	$archive_run_make_screenshot && handler_screenshot_parse_arguments
	$archive_run_singlefile && handler_singlefile_parse_arguments
	$archive_run_json_to_html && handler_json_to_html_parse_arguments

	if (($# > 0)); then
		__error "unknown program argument %s" "$1"
		local_exit_failsafe
	fi

	if $archive_run_wget || $archive_run_wget_text || $archive_run_make_screenshot || $archive_run_singlefile || $archive_run_gallerydl || $archive_run_json_to_html; then
		[[ -n "$temporary_files_path" ]] || { __error "temporary_files_path is empty"; local_exit_failsafe; }
        [[ -n "$archive_path" ]] || { __error "archive_path is empty"; local_exit_failsafe; }
        local temp_real
        temp_real="$(realpath --canonicalize-missing -- "$temporary_files_path")" || { __error "cannot resolve temporary_files_path %s" "$temporary_files_path"; local_exit_failsafe; }
        local out_real
        out_real="$(realpath --canonicalize-missing -- "$archive_path")" || { __error "cannot resolve archive_path %s" "$archive_path"; local_exit_failsafe; }

		if [[ "$temp_real" == "$out_real" || "$temp_real" == "$out_real"/* ]]; then
			__error "temporary_files_path %s is inside output path %s" "$temp_real" "$out_real"
			local_exit_failsafe
		fi
	fi

	gallerydl_dump_path="$(handler_base_path "gallery-dl")"
	web_archive_path="$(handler_base_path "wget")"
	mkdir --parents -- "$gallerydl_dump_path/" "$web_archive_path/"

	run_directory="$archive_path/run/run-$(date "+%d.%m.%Y [%H∶%M∶%S]")"
	run_error_log="$run_directory/error.log"
	run_missing_screenshots_log="$run_directory/missing.screenshots.log"
	mkdir --parents -- "$run_directory"
	: >| "$run_error_log"
	: >| "$run_missing_screenshots_log"

	__heading "Parsing sources"
	__info "Parsing path %s…" "$bibliography_sources_path"
	parse_sources_path "$bibliography_sources_path" -1 --new-line-format $additional_arguments || __failure "Parsing failed!"
	if ! validate_tree; then
		__failure "Validating sources failed!"
		__error "Tree validation failed!"
		local_exit_failsafe
	fi
	__success "Parsing completed."

	 if $print_sources; then
		print_tree true true
		__info "[%s] done." "__$__current_script_name"
		exit 0
	fi

	if $archive_status || $archive_update_status; then
		extract_urls_from_bibliography
		__info "[%s] done." "__$__current_script_name"
		exit 0
	fi

	$__debug && print_tree true true

	if $update_archive; then
		__heading "Offline archive"
		__info "Managing the offline archive for all urls from the current bibliography…"
		extract_urls_from_bibliography || __failure "Offline archive failed!"
		__success "Offline archive completed."
	fi
}
