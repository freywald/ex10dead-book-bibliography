				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			archive_run_wget=false
			archive_run_singlefile=false
			archive_run_make_screenshot=false
			archive_run_gallerydl=true
			force_update_existing=true
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--archive-gallerydl-id="* ]]; then
			filter_by_id="${1#--archive-gallerydl-id=}"
			if [[ -z "$filter_by_id" ]]; then
				__error "--archive-gallerydl-id requires an id"
				local_exit_failsafe
			fi
			archive_run_wget=false
			archive_run_singlefile=false
			archive_run_make_screenshot=false
			archive_run_gallerydl=true
			force_update_existing=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-gallerydl" ]]; then
			show_missing_gallerydl=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-screenshot" ]]; then
			show_missing_screenshot=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-wget-text" ]]; then
			show_missing_wget_text=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-thread-html" ]]; then
			show_missing_thread_html=true
			shift || __expression_may_fail
		elif [[ "$1" == "--configuration-file" ]]; then
			[[ -n "${2-}" ]] || { __error "--configuration-file requires a path"; local_exit_failsafe; }
			configuration_files+=("$2")
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--configuration-file="* ]]; then
			[[ -n "${1#--configuration-file=}" ]] || { __error "--configuration-file requires a path"; local_exit_failsafe; }
			configuration_files+=("${1#--configuration-file=}")
			shift || __expression_may_fail
		elif [[ "$1" == "--method-enable-gallerydl" ]]; then
			archive_run_gallerydl=true
			load_handler "./handlers/gallerydl-handler"
			shift || __expression_may_fail
		elif [[ "$1" == "--method-enable-screenshots" ]]; then
			archive_run_make_screenshot=true
			load_handler "./handlers/screenshot-handler"
			shift || __expression_may_fail
		elif [[ "$1" == "--method-enable-singlefile" ]]; then
			archive_run_singlefile=true
			load_handler "./handlers/singlefile-handler"
			shift || __expression_may_fail
		elif [[ "$1" == "--method-enable-wget" ]]; then
