#!/bin/bash

LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH="Build/libraries/ex10dead-book-bibliography/" # @todo set from outside
LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH="Build/libraries/" # @todo set from outside

source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format" || exit 1
source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format.bibliography" || exit 1
source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/build-base" || exit 1
source -- "./$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/utilities/utilities" || exit 1

# configuration start

gallerydl_dump_directory_name="dump"
web_archive_directory_name="web-archive"
temporary_files_path="${TMPDIR:-/tmp}/bibliography-work"
wget_text_arguments=()
wget_text_arguments_file=""
declare -gA handler_enabled=()
declare -gA handler_output_path=()
declare -gA handler_leaf_name=()

# configuration end

# script task start

abort_on_interrupt() {
	local status="${1:-$?}"
	if (( status == 130 || status == 143 )); then
		exit "$status"
	fi
	return 0
}

apply_configuration_enables() {
	verify_handler_layout

	if [[ "${handler_enabled[gallery-dl]}" == "true" ]] && ! $archive_run_gallerydl; then
		archive_run_gallerydl=true
		load_handler "./handlers/gallerydl-handler"
	fi
	if [[ "${handler_enabled[wget]}" == "true" ]] && ! $archive_run_wget; then
		archive_run_wget=true
		load_handler "./handlers/wget-handler"
	fi
	if [[ "${handler_enabled[wget-text]}" == "true" ]] && ! $archive_run_wget_text; then
		archive_run_wget_text=true
		load_handler "./handlers/wget-text-handler"
	fi
	if [[ "${handler_enabled[screenshot]}" == "true" ]] && ! $archive_run_make_screenshot; then
		archive_run_make_screenshot=true
		load_handler "./handlers/screenshot-handler"
	fi
	if [[ "${handler_enabled[singlefile]}" == "true" ]] && ! $archive_run_singlefile; then
		archive_run_singlefile=true
		load_handler "./handlers/singlefile-handler"
	fi
	if [[ "${handler_enabled[json-to-html]}" == "true" ]] && ! $archive_run_json_to_html; then
		archive_run_json_to_html=true
		load_handler "./handlers/json-to-html-handler"
	fi
	[[ -n "${handler_output_path[gallery-dl]-}" ]] && gallerydl_dump_directory_name="${handler_output_path[gallery-dl]}"
	[[ -n "${handler_output_path[wget]-}" ]] && web_archive_directory_name="${handler_output_path[wget]}"
}

status_wanted() {
	local zip_ok="$1" singlefile_ok="$2" screenshot_ok="$3" gallerydl_ok="$4" remote="${5-}" wget_text_ok="${6:-true}" reconstruct_ok="${7:-true}"
	if ! $show_archived && ! $show_missing && ! $show_missing_wget \
		&& ! $show_missing_singlefile && ! $show_missing_screenshot \
		&& ! $show_missing_gallerydl && ! $show_missing_download \
		&& ! $show_missing_wget_text && ! $show_missing_thread_html; then
		return 0
	fi

	local wget_ok=true sf_ok=true shot_ok=true gdl_ok=true text_ok=true html_ok=true
	$archive_run_wget && wget_ok=$zip_ok
	$archive_run_singlefile && sf_ok=$singlefile_ok
	$archive_run_make_screenshot && shot_ok=$screenshot_ok
	$archive_run_gallerydl && gdl_ok=$gallerydl_ok
	$archive_run_wget_text && text_ok=$wget_text_ok
	$archive_run_json_to_html && html_ok=$reconstruct_ok

	local want=false
	$show_archived && $wget_ok && $sf_ok && $shot_ok && $gdl_ok && $text_ok && $html_ok && want=true
	$show_missing && { $wget_ok && $sf_ok && $shot_ok && $gdl_ok && $text_ok && $html_ok || want=true; }
	$show_missing_wget && ! $zip_ok && want=true
	$show_missing_singlefile && ! $singlefile_ok && want=true
	$show_missing_screenshot && ! $screenshot_ok && want=true
	$show_missing_gallerydl && ! $gallerydl_ok && want=true
	$show_missing_wget_text && ! $wget_text_ok && want=true
	$show_missing_thread_html && ! $reconstruct_ok && want=true
	$show_missing_download && [[ "$remote" == download* || "$remote" == remote-newer* || "$remote" == etag-differs* ]] && want=true
	$want
}

print_archive_status() {
	local probe="${1:-false}"
	local queued_url zip_archive work_dir status remote_note http_status
	local headers remote_mtime local_mtime last_modified etag
	local screenshot_existing=0 screenshot_missing=0
	local wget_existing=0 wget_missing=0
	local singlefile_existing=0 singlefile_missing=0
	local gallerydl_existing=0 gallerydl_missing=0
	local wget_text_existing=0 wget_text_missing=0
	local reconstruct_existing=0 reconstruct_missing=0
	local url_count=0

	for queued_url in "${!queued_urls[@]}"; do
		url_count=$((url_count + 1))
		local id="${queued_ids[$queued_url]}"
		work_dir="$(handler_id_dir wget "$id")"
		zip_archive="$(archive_zip_path "$queued_url" "$id" "${queued_kinds[$queued_url]}" wget)"

		local zip_ok=false singlefile_ok=false screenshot_ok=false gallerydl_ok=false
		local wget_text_ok=false reconstruct_ok=false
		remote_note=""
		local zip_display="$zip_archive"
		if [[ "$zip_archive" == "$__current_directory"* ]]; then
			zip_display="${zip_archive#"$__current_directory"}"
		fi
		if [[ "$zip_display" == "$archive_path"* ]]; then
			zip_display="${zip_display#"$archive_path"}"
		fi
		local screenshot_file="$(handler_leaf_dir "screenshot" "$id")/screenshot.png"
		local screenshot_display="$screenshot_file"
		if [[ "$screenshot_file" == "$__current_directory"* ]]; then
			screenshot_display="${screenshot_file#"$__current_directory"}"
		fi
		if [[ "$screenshot_display" == "$archive_path"* ]]; then
			screenshot_display="${screenshot_display#"$archive_path"}"
		fi
		screenshot_display="${screenshot_display#/}"
		local singlefile_path="$(handler_leaf_dir "singlefile" "$id")/$(basename -- "$zip_archive" .zip).singlefile.html"
		local singlefile_display="${singlefile_path#"$archive_path"}"
		singlefile_display="${singlefile_display#/}"
		zip_display="${zip_display#/}"
		local gallerydl_file="" gallerydl_display="" tweet_id
		tweet_id="$(twitter_status_id "$queued_url")" || tweet_id=""

		gallerydl_file="$(gallerydl_json_for_url "$queued_url")"|| gallerydl_file=""
		if [[ -n "$gallerydl_file" && -f "$gallerydl_file" ]]; then
			gallerydl_display="${gallerydl_file#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
			gallerydl_ok=true
		elif [[ -n "$tweet_id" ]]; then
			gallerydl_display="$(handler_leaf_dir "gallery-dl" "$id")/${tweet_id}.json"
			gallerydl_display="${gallerydl_display#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
		else
			gallerydl_display="Missing json in: $(handler_leaf_dir "gallery-dl" "$id")/"
			gallerydl_display="${gallerydl_display#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
		fi

		local wget_text_target reconstruct_file
		if $wget_text_output_as_zip; then
			wget_text_target="$(archive_zip_path "$queued_url" "$id" "${queued_kinds[$queued_url]}" wget-text)"
		else
			wget_text_target="$(handler_leaf_dir "wget-text" "$id")/SUCCESSFUL_DOWNLOAD"
		fi
		local wget_text_display="${wget_text_target#"$archive_path"}"
		wget_text_display="${wget_text_display#/}"
		reconstruct_file="$(handler_leaf_dir "json-to-html" "$id")/reconstructed-twitter-thread.html"
		local reconstruct_display="${reconstruct_file#"$archive_path"}"
		reconstruct_display="${reconstruct_display#/}"

		[[ -f "$zip_archive" ]] && zip_ok=true
		[[ -f "$singlefile_path" ]] && singlefile_ok=true
		[[ -f "$screenshot_file" ]] && screenshot_ok=true
		[[ -f "$wget_text_target" ]] && wget_text_ok=true
		[[ -f "$reconstruct_file" ]] && reconstruct_ok=true
		if $archive_run_make_screenshot; then
			if $screenshot_ok; then screenshot_existing=$((screenshot_existing + 1)); else screenshot_missing=$((screenshot_missing + 1)); fi
		fi
		if $archive_run_wget; then
			if $zip_ok; then wget_existing=$((wget_existing + 1)); else wget_missing=$((wget_missing + 1)); fi
		fi
		if $archive_run_singlefile; then
			if $singlefile_ok; then singlefile_existing=$((singlefile_existing + 1)); else singlefile_missing=$((singlefile_missing + 1)); fi
		fi
		if $archive_run_gallerydl; then
			if $gallerydl_ok; then gallerydl_existing=$((gallerydl_existing + 1)); else gallerydl_missing=$((gallerydl_missing + 1)); fi
		fi
		if $archive_run_wget_text; then
			if $wget_text_ok; then wget_text_existing=$((wget_text_existing + 1)); else wget_text_missing=$((wget_text_missing + 1)); fi
		fi
		if $archive_run_json_to_html; then
			if $reconstruct_ok; then reconstruct_existing=$((reconstruct_existing + 1)); else reconstruct_missing=$((reconstruct_missing + 1)); fi
		fi

		if $probe && $archive_run_wget; then
			local -a curl_args=(--silent --head --location --write-out "%{http_code}" --max-time 10)
			[[ -n "${gallery_dl_cookie_file-}" && -f "$gallery_dl_cookie_file" ]] && curl_args+=(--cookie "$gallery_dl_cookie_file")
			headers="$(curl "${curl_args[@]}" -- "$queued_url")" || status=$?
			abort_on_interrupt "$status"
			if (( status != 0 )); then
				headers=""
			fi
			http_status="${headers: -3}"
			http_status="${http_status:-000}"

			if [[ -z "$headers" || "$http_status" == "000" ]]; then
				remote_note="unreachable"
			elif [[ "$http_status" != 2* ]]; then
				remote_note="http ${http_status}"
			else
				last_modified="$(printf '%s\n' "$headers" | { grep -i '^last-modified:' ||:; } | head -1 | cut -d: -f2-)"
				last_modified="${last_modified-}"
				last_modified="${last_modified#"${last_modified%%[![:space:]]*}"}"
				last_modified="${last_modified%"${last_modified##*[![:space:]]}"}"
				etag="$(printf '%s\n' "$headers" | { grep -i '^etag:' ||:; } | head -1 | cut -d: -f2- | tr -d '\" ')"
				remote_mtime=0
				local status=0
				if [[ -n "$last_modified" ]]; then
					remote_mtime="$(date -d "$last_modified" "+%s")" || status=$?
					abort_on_interrupt "$status"
					if (( status != 0 )); then
						__error "bad Last-Modified %s" "$last_modified"
						return "$status"
					fi
				fi

				local_mtime=0
				status=0
				if [[ -f "$zip_archive" ]]; then
					local_mtime="$(stat -c "%Y" -- "$zip_archive")" || status=$?
					abort_on_interrupt "$status"
					if (( status != 0 )); then
						__error "cannot stat %s" "$zip_archive"
						return "$status"
					fi
				fi
			fi
		fi

		if $archive_run_make_screenshot; then
			expected_archive_paths["$screenshot_display"]=1
			expected_archive_paths["$web_archive_directory_name/${queued_ids[$queued_url]}"]=1
		fi
		if $archive_run_gallerydl; then
			[[ -n "$gallerydl_display" ]] && expected_archive_paths["$gallerydl_display"]=1
			expected_archive_paths["$gallerydl_dump_directory_name/${queued_ids[$queued_url]}"]=1
		fi
		if $archive_run_singlefile; then
			expected_archive_paths["$singlefile_display"]=1
		fi
		if $archive_run_wget; then
			expected_archive_paths["$zip_display"]=1
			expected_archive_paths["${zip_display}.etag"]=1
		fi
		if $archive_run_wget_text; then
			expected_archive_paths["$wget_text_display"]=1
		fi
		if $archive_run_json_to_html; then
			expected_archive_paths["$reconstruct_display"]=1
			expected_archive_paths["${reconstruct_display%.html}.manifest"]=1
		fi

		status_wanted "$zip_ok" "$singlefile_ok" "$screenshot_ok" "$gallerydl_ok" "$remote_note" "$wget_text_ok" "$reconstruct_ok" || continue

		__heading "%s" "$queued_url"

		if $archive_run_make_screenshot; then
			local screenshot_status screenshot_status_color
			if $screenshot_ok; then
				screenshot_status="archived"
				screenshot_status_color="${__COLOR_SUCCESS}"
			else
				screenshot_status="missing"
				screenshot_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$screenshot_status_color"'%s'"${COLOR_RESET1}"']\n\tscreenshot:\t%s\n' "${screenshot_status^^}" "$screenshot_display"
		fi

		if $archive_run_gallerydl; then
			local gallerydl_status gallerydl_status_color
			if $gallerydl_ok; then
				gallerydl_status="archived"
				gallerydl_status_color="${__COLOR_SUCCESS}"
			else
				gallerydl_status="missing"
				gallerydl_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$gallerydl_status_color"'%s'"${COLOR_RESET1}"']\n\tgallery-dl:\t%s\n' "${gallerydl_status^^}" "$gallerydl_display"
		fi

		if $archive_run_singlefile; then
			local singlefile_status singlefile_status_color
			if $singlefile_ok; then
				singlefile_status="archived"
				singlefile_status_color="${__COLOR_SUCCESS}"
			else
				singlefile_status="missing"
				singlefile_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$singlefile_status_color"'%s'"${COLOR_RESET1}"']\n\tsinglefile:\t%s\n' "${singlefile_status^^}" "$singlefile_display"
		fi

		if $archive_run_wget; then
			local status_color
			if $zip_ok; then
				status="archived"
				status_color="${__COLOR_SUCCESS}"
			else
				status="missing"
				status_color="${__COLOR_WARNING}"
			fi
			if [[ -n "$remote_note" ]]; then
				status="$status/${remote_note}"
			fi
			printf '['"$status_color"'%s'"${COLOR_RESET1}"']\n\twget:\t\t%s\n' "${status^^}" "$zip_display"
		fi
		if $archive_run_wget_text; then
			local wget_text_status wget_text_color
			if $wget_text_ok; then
				wget_text_status="archived"
				wget_text_color="${__COLOR_SUCCESS}"
			else
				wget_text_status="missing"
				wget_text_color="${__COLOR_WARNING}"
			fi
			printf '['"$wget_text_color"'%s'"${COLOR_RESET1}"']\n\twget-text:\t%s\n' "${wget_text_status^^}" "$wget_text_display"
		fi
		if $archive_run_json_to_html; then
			local reconstruct_status reconstruct_color
			if $reconstruct_ok; then
				reconstruct_status="archived"
				reconstruct_color="${__COLOR_SUCCESS}"
			else
				reconstruct_status="missing"
				reconstruct_color="${__COLOR_WARNING}"
			fi
			printf '['"$reconstruct_color"'%s'"${COLOR_RESET1}"']\n\tthread-html:\t%s\n' "${reconstruct_status^^}" "$reconstruct_display"
		fi
	done

	__heading "Archive status"
	__info "urls %s" "$url_count"
	if $archive_run_gallerydl; then
		__info "gallery-dl count existing %s, count missing %s" "$gallerydl_existing" "$gallerydl_missing"
	fi
	if $archive_run_make_screenshot; then
		__info "screenshot count existing %s, count missing %s" "$screenshot_existing" "$screenshot_missing"
	fi
	if $archive_run_wget; then
		__info "wget count existing %s, count missing %s" "$wget_existing" "$wget_missing"
	fi
	if $archive_run_singlefile; then
		__info "singlefile count existing %s, count missing %s" "$singlefile_existing" "$singlefile_missing"
	fi
	if $archive_run_wget_text; then
		__info "wget-text count existing %s, count missing %s" "$wget_text_existing" "$wget_text_missing"
	fi
	if $archive_run_json_to_html; then
		__info "thread-html count existing %s, count missing %s" "$reconstruct_existing" "$reconstruct_missing"
	fi

	local base parent under_expected scanned=0
	local -a orphans=()
	local -a scan_roots=()
	[[ -d "$web_archive_path" ]] && scan_roots+=("$web_archive_path")
	[[ -d "$gallerydl_dump_path" ]] && scan_roots+=("$gallerydl_dump_path")
	((${#scan_roots[@]} == 0)) && return 0
	__info "scanning archive trees for orphans"
	while IFS= read -r -d '' file; do
		scanned=$((scanned + 1))
		if (( scanned % 2000 == 0 )); then
			__info "orphan scan %s paths" "$scanned"
		fi
		local relative_file="$file"
		if [[ "$relative_file" == "$archive_path"* ]]; then
			relative_file="${relative_file#"$archive_path"}"
			relative_file="${relative_file#/}"
		fi

		case "$relative_file" in
			""|"$gallerydl_dump_directory_name"|"$web_archive_directory_name") continue ;;
		esac

		if [[ -n "${expected_archive_paths["$relative_file"]+set}" ]]; then
			continue
		fi
		under_expected=false
		parent="$relative_file"
		while [[ "$parent" == */* ]]; do
			parent="${parent%/*}"
			if [[ -n "${expected_archive_paths["$parent"]+set}" ]]; then
				under_expected=true
				break
			fi
		done
		if $under_expected; then
			continue
		fi

		base="$(basename -- "$relative_file")"

		case "$relative_file" in
			*/__backups|*/__backups/*) continue ;;
			"$gallerydl_dump_directory_name"/gallery-dl.cache.sqlite3*) continue ;;
			*.manifest|*/SUCCESSFUL_DOWNLOAD) continue ;;
		esac
		case "$base" in
			__backups|SUCCESSFUL_DOWNLOAD) continue ;;
		esac

		if [[ "$relative_file" == "$gallerydl_dump_directory_name"/* ]]; then
			local dump_dir="$file"
			[[ -f "$file" ]] && dump_dir="$(dirname -- "$file")"
			local dump_id
			dump_id="$(basename -- "$dump_dir")"
			if [[ -f "$dump_dir/$dump_id.json" ]]; then
				continue
			fi
		fi

		case "$base" in
			*.zip|*.zip.etag|*.singlefile.html|*.json|*.JSON|screenshot.png|reconstructed-twitter-thread.html) ;;
			*.jpg|*.jpeg|*.png|*.gif|*.webp|*.mp4|*.txt) ;;
			*)
				if [[ ! -d "$file" ]]; then
					continue
				fi
				local -a children=("$file"/*)
				if ((${#children[@]} > 0)); then
					continue
				fi
				;;
		esac

		orphans+=("$relative_file")
	done < <(find "${scan_roots[@]}" \( -type f -o -type d \) -print0)
	__info "orphan scan finished, %s paths, %s orphans" "$scanned" "${#orphans[@]}"

	if ((${#orphans[@]} > 0)); then
		__heading "Not in bibliography"
		for orphan in "${orphans[@]}"; do
			__info "orphan archive path %s" "${orphan#"$__current_directory"}"
		done
	fi
}

function manage_archive_for_url() {
	local url="$1"
	local url_identifier="$2"
	local url_kind="$3"

	__verbose "handling url %s" "$url"

	local target_directory_name zip_archive singlefile_path
	target_directory_name="$(handler_id_dir wget "$url_identifier")"
	zip_archive="$(archive_zip_path "$url" "$url_identifier" "$url_kind" wget)"
	singlefile_path="$(handler_leaf_dir "singlefile" "$url_identifier")/$(basename -- "$zip_archive" .zip).singlefile.html"
	local screenshot_path="$(handler_leaf_dir "screenshot" "$url_identifier")/screenshot.png"

	local wget_status=0 singlefile_status=0 screenshot_status=0 gallerydl_status=0 wget_text_status=0

	if $archive_run_wget; then
		handler_wget_download "$url" "$target_directory_name/" "$url_identifier" "$url_kind" || wget_status=$?
		if (( wget_status == 130 || wget_status == 143 )); then exit "$wget_status"; fi
		if (( wget_status != 0 )); then
			__warn "archive incomplete for %s after wget status %s" "$url" "$wget_status"
			return 0
		fi
	fi
	if $archive_run_singlefile; then
		handler_singlefile_download "$url" "$singlefile_path" || singlefile_status=$?
		if (( singlefile_status == 130 || singlefile_status == 143 )); then exit "$singlefile_status"; fi
		if (( singlefile_status != 0 )); then
			__warn "archive incomplete for %s after singlefile status %s" "$url" "$singlefile_status"
			return 0
		fi
	fi
	if $archive_run_gallerydl; then
		handler_gallerydl_download "$url" || gallerydl_status=$?
		if (( gallerydl_status == 130 || gallerydl_status == 143 )); then exit "$gallerydl_status"; fi
		if (( gallerydl_status != 0 )); then
			__warn "archive incomplete for %s after gallery-dl status %s" "$url" "$gallerydl_status"
			return 0
		fi
	fi
	if $archive_run_wget_text; then
		local wget_text_domain="${url#*://}"
		wget_text_domain="${wget_text_domain%%/*}"
		local wget_text_out
		if $wget_text_output_as_zip; then
			wget_text_out="$(archive_zip_path "$url" "$url_identifier" "$url_kind" wget-text)"
		else
			wget_text_out="$(handler_leaf_dir "wget-text" "$url_identifier")/$(basename -- "$url_identifier")"
		fi
		handler_wget_text_download "$url" "$wget_text_domain" "$wget_text_out" || wget_text_status=$?
		if (( wget_text_status == 130 || wget_text_status == 143 )); then exit "$wget_text_status"; fi
		if (( wget_text_status != 0 )); then
			__warn "archive incomplete for %s after wget-text status %s" "$url" "$wget_text_status"
			return 0
		fi
	fi
	if $archive_run_make_screenshot; then
		local screenshot_existed=false
		if [[ -f "$screenshot_path" ]] && ! $force_update_existing; then
			screenshot_existed=true
		fi

		handler_make_screenshot_with_shot_scraper "$url" "$screenshot_path" || screenshot_status=$?
		if (( screenshot_status == 130 || screenshot_status == 143 )); then exit "$screenshot_status"; fi
		if (( screenshot_status == 0 )) && ! $screenshot_existed; then
			local screenshot_pause=$((5 + RANDOM % 10))
			__info "waiting %s seconds before the next screenshot" "$screenshot_pause"
			sleep "$screenshot_pause"
		fi
		if (( screenshot_status != 0 )); then
			__warn "stopping %s after screenshot status %s" "$url" "$screenshot_status"
			return 0
		fi
	fi

#	if $archive_run_wget; then
#		handler_wget_download "$url" "$target_directory_name/" "$url_identifier" "$url_kind" || wget_status=$?
#	fi
#	if $archive_run_singlefile; then
#		handler_singlefile_download "$url" "$singlefile_path" || singlefile_status=$?
#	fi
#	if $archive_run_gallerydl; then
#		handler_gallerydl_download "$url" || gallerydl_status=$?
#	fi
#	if $archive_run_wget_text; then
#		local wget_text_domain="${url#*://}"
#		wget_text_domain="${wget_text_domain%%/*}"
