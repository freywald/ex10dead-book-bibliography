	show_missing=false
	show_missing_wget=false
	show_missing_singlefile=false
	show_missing_screenshot=false
	show_missing_download=false
	show_missing_gallerydl=false
	show_missing_wget_text=false
	show_missing_thread_html=false
	configuration_file=""
	wget_text_output_as_zip=true
	additional_arguments=""
	wget_text_arguments=()
	wget_text_arguments_file=""
	backup_existing_archive=false
	configuration_files=()

	local -a handler_arguments=()
	while (($# > 0 )); do
		if [[ "$1" == "--debug" ]]; then
			__debug=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--verbose" ]]; then
			__verbose=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--quiet" ]]; then
			__quiet=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--print" || "$1" == "--print-sources" ]]; then
			print_sources=true
			shift || __expression_may_fail
		elif [[ "$1" == "--warn-on-ids" ]]; then
			additional_arguments="--warn-on-ids $additional_arguments"; shift || __expression_may_fail
		elif [[ "$1" == "--update-archive" ]]; then
			update_archive=true
			shift || __expression_may_fail
		elif [[ "$1" == "--status" ]]; then
			archive_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--status-updated" ]]; then
			archive_update_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-archived" ]]; then
			show_archived=true; shift || __expression_may_fail
		elif [[ "$1" == "--show-missing" ]]; then
			show_missing=true; shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-wget" ]]; then
			show_missing_wget=true; shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-singlefile" ]]; then
			show_missing_singlefile=true; shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-download" ]]; then
			show_missing_download=true
			archive_update_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing*" || "$1" == "--show-missing-all" ]]; then
			show_missing=true
			show_missing_wget=true
			show_missing_singlefile=true
			show_missing_download=true
			show_missing_screenshot=true
			show_missing_gallerydl=true
			show_missing_wget_text=true
			show_missing_thread_html=true
			archive_update_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--force-update-existing" ]]; then
			force_update_existing=true
			shift ||__expression_may_fail
		elif [[ "$1" == "--archive-id" ]]; then
			if [[ -z "${2-}" || "$2" == --* ]]; then
				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			force_update_existing=true
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--archive-id="* ]]; then
			filter_by_id="${1#--archive-id=}"
			if [[ -z "$filter_by_id" ]]; then
				__error "--archive-id requires an id"
				local_exit_failsafe
			fi
			force_update_existing=true
			shift || __expression_may_fail
		elif [[ "$1" == "--archive-wget-id" ]]; then
			if [[ -z "${2-}" || "$2" == --* ]]; then
				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			archive_run_wget=true
			archive_run_singlefile=false
			archive_run_make_screenshot=false
			archive_run_gallerydl=false
			force_update_existing=true
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--archive-wget-id="* ]]; then
			filter_by_id="${1#--archive-wget-id=}"
			if [[ -z "$filter_by_id" ]]; then
				__error "--archive-wget-id requires an id"
				local_exit_failsafe
			fi
			archive_run_wget=true
			archive_run_singlefile=false
			archive_run_make_screenshot=false
			archive_run_gallerydl=false
			force_update_existing=true
			shift || __expression_may_fail
		elif [[ "$1" == "--archive-singlefile-id" ]]; then
			if [[ -z "${2-}" || "$2" == --* ]]; then
				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			archive_run_wget=false
			archive_run_singlefile=true
			archive_run_make_screenshot=false
			archive_run_gallerydl=false
			force_update_existing=true
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--archive-singlefile-id="* ]]; then
			filter_by_id="${1#--archive-singlefile-id=}"
			if [[ -z "$filter_by_id" ]]; then
				__error "--archive-singlefile-id requires an id"
				local_exit_failsafe
			fi
			archive_run_wget=false
			archive_run_singlefile=true
			archive_run_make_screenshot=false
			archive_run_gallerydl=false
			force_update_existing=true
			shift || __expression_may_fail
