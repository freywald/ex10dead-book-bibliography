				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			shift 2 || __expression_may_fail
		elif [[ "$1" == "--select-id="* ]]; then
			filter_by_id="${1#--select-id=}"
			if [[ -z "$filter_by_id" ]]; then
				__error "--select-id requires an id"
				local_exit_failsafe
			fi
			shift || __expression_may_fail
		elif [[ "$1" == "--archive-screenshot-id" ]]; then
			if [[ -z "${2-}" || "$2" == --* ]]; then
				__error "%s requires an id" "$1"
				local_exit_failsafe
			fi
			filter_by_id="$2"
			archive_run_wget=false
			archive_run_singlefile=false
			archive_run_make_screenshot=true
