function extract_urls_from_bibliography() {
	generate_tree "-1" false false ""
	verify_tree
	declare -A url_owners=()

	if [[ "$filter_by_id" == http://* || "$filter_by_id" == https://* ]]; then
		archive_url_filter="$filter_by_id"
		filter_by_id=""
		local key owner="" owners=0
		for key in "${tree_order[@]}"; do
			local u
			u="$(get_metadata "_" "$key")"
			if [[ "$u" == "$archive_url_filter" ]]; then
				owner="$(get_metadata "_id" "$key")"
				if [[ -z "$owner" || "$owner" == *"※"* ]]; then
					owner="$(nearest_non_reference_parent_id "$key")" || owner=""
				fi
				[[ -n "$owner" ]] || owner="__root"
				url_owners["$owner"]=1
				filter_by_id="$owner"
				continue
			fi
			local field
			for field in url additional_url archive_url mirror_url; do
				while IFS= read -r u; do
					[[ "$u" == "$archive_url_filter" ]] || continue
					owner="$(get_metadata "_id" "$key")"
					if [[ -z "$owner" || "$owner" == *"※"* ]]; then
						owner="$(nearest_non_reference_parent_id "$key")" || owner=""
					fi
					[[ -n "$owner" ]] || owner="__root"
					url_owners["$owner"]=1
					filter_by_id="$owner"
				done < <(get_values "$key" "$field" true)
			done
		done

		owners="${#url_owners[@]}"
		if (( owners == 0 )); then
			__error "url is not in the bibliography: %s" "$archive_url_filter"
			local_exit_failsafe
		fi
		if (( owners > 1 )); then
			__error "url %s belongs to more than one title; pass --archive-id=TITLE/ and the url" "$archive_url_filter"
			local_exit_failsafe
		fi
		archive_id_with_extras=true
		__info "url %s belongs to %s" "$archive_url_filter" "$filter_by_id"
	fi
	declare -A title_urls=()
	declare -A queued_urls=()
	declare -A queued_ids=()
	declare -A queued_kinds=()
	declare -a ignored_reference_keys=()
	declare -a ignored_reference_urls=()
	declare -a ignored_reference_kinds=()
	wget_zip_paths_this_session=()

	local key
	for key in "${tree_order[@]}"; do
		local entry_key
		entry_key="$(get_entry_key "$key")"

		local type=""
		type="$(resolved_type "$key")" || type=""

		local data_kind=""
		if [[ -n "$type" ]]; then
			data_kind="${type#*":"}"
			type="${type%%":"*}"
			if [[ "$type" == "$data_kind" ]]; then
				data_kind=""
			fi
		fi

		local is_video_url=false
		if [[ "$type" == "video" && "$data_kind" == "url" ]]; then
			is_video_url=true
		fi

		local -a entry_data_urls=()
		local -a field_urls=()

		if $is_video_url; then
			mapfile -t field_urls < <(
				get_values "$key" "additional_url" true
				get_values "$key" "archive_url" true
				get_values "$key" "mirror_url" true
			)
		else
			if [[ "$data_kind" == "url" ]]; then
				mapfile -t entry_data_urls < <(get_metadata "_" "$key")
			fi
			mapfile -t field_urls < <(
				get_values "$key" "url" true
				get_values "$key" "additional_url" true
				get_values "$key" "archive_url" true
				get_values "$key" "mirror_url" true
			)
		fi

		if [[ -n "$archive_url_filter" ]]; then
			local main_url
			main_url="$(get_metadata "_" "$key")"
			if [[ "$main_url" == "$archive_url_filter" ]]; then
				field_urls+=("$main_url")
			fi
		fi

		if [[ "$entry_key" == *"※"* ]]; then
			__verbose "reference bibliography entry %s is ignored" "$entry_key"
			local ignored_url
			for ignored_url in "${entry_data_urls[@]}" "${field_urls[@]}"; do
				[[ -z "$ignored_url" ]] && continue
				ignored_reference_keys+=("$key")
				ignored_reference_urls+=("$ignored_url")
				ignored_reference_kinds+=("field")
			done

			continue
		fi

		local id
		id="$(get_metadata "_id" "$key")"
		if [[ -z "$id" || "$id" == *"※"* ]]; then
			local work_id=""
			work_id="$(nearest_non_reference_parent_id "$key")" || work_id=""
			if [[ -n "$work_id" ]]; then
				id="$work_id"
			elif [[ -z "$id" ]]; then
				__info "no _id on %s and no non-reference parent id; using __root" "$key"
				id="__root"
			else
				__warn "reference entry %s has no non-reference parent id; using __root" "$key"
				id="__root"
			fi
		fi

		local url_kind_entry="entry"
		local url_kind_field="field"
		if is_attribute_under_reference "$key"; then
			url_kind_entry="attribute-field"
			url_kind_field="attribute-field"
		fi

		local candidate
		for candidate in "${entry_data_urls[@]}"; do
			[[ -z "$candidate" ]] && continue
			title_urls["$candidate"]=1
			if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$id"; then
				continue
			fi
			if [[ -n "$archive_url_filter" && "$candidate" != "$archive_url_filter" ]]; then
				continue
			fi
			if [[ -n "${queued_urls[$candidate]+set}" ]]; then
				[[ "$url_kind_entry" == "entry" ]] && queued_kinds["$candidate"]="entry"
				continue
			fi
			queued_urls["$candidate"]=1
			queued_ids["$candidate"]="$id"
			queued_kinds["$candidate"]="$url_kind_entry"
		done

		for candidate in "${field_urls[@]}"; do
			[[ -z "$candidate" ]] && continue
			title_urls["$candidate"]=1
			if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$id"; then
				continue
			fi
			if [[ -n "$filter_by_id" ]] && ! $archive_id_with_extras; then
				continue
			fi
			if [[ -n "$archive_url_filter" && "$candidate" != "$archive_url_filter" ]]; then
				continue
			fi
			if [[ -n "${queued_urls[$candidate]+set}" ]]; then
				continue
			fi
			queued_urls["$candidate"]=1
			queued_ids["$candidate"]="$id"
			queued_kinds["$candidate"]="$url_kind_field"
		done
	done

	local i
	 for ((i = 0; i < ${#ignored_reference_urls[@]}; i++)); do
		local ignored_key="${ignored_reference_keys[$i]}"
		local ignored_url="${ignored_reference_urls[$i]}"
		local ignored_kind="${ignored_reference_kinds[$i]}"

		if [[ -n "${title_urls[$ignored_url]+set}" ]]; then
			continue
		fi

		local ignored_entry_key
		ignored_entry_key="$(get_entry_key "$ignored_key")"

		local archive_id=""
		if [[ "$ignored_entry_key" == *"※"* ]]; then
			archive_id="$(nearest_non_reference_parent_id "$ignored_key")" || archive_id=""
		fi
		if [[ -z "$archive_id" ]]; then
			archive_id="$(nearest_parent_id "$ignored_key")" || archive_id=""
		fi
		if [[ -z "$archive_id" ]]; then
			archive_id="__root"
		fi
		if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$archive_id"; then
			continue
		fi
		if [[ -n "$filter_by_id" ]] && ! $archive_id_with_extras; then
			continue
		fi
		if [[ -n "$archive_url_filter" && "$ignored_url" != "$archive_url_filter" ]]; then
			continue
		fi
		 $__verbose && __warn "reference entry %s (%s) has url %s that never appeared as a title entry; archiving under %s" "$ignored_entry_key" "$ignored_key" "$ignored_url" "$archive_id"

		if [[ -n "${queued_urls[$ignored_url]+set}" ]]; then
			[[ "$ignored_kind" == "entry" ]] && queued_kinds["$ignored_url"]="entry"
			continue
		fi

		queued_urls["$ignored_url"]=1
		queued_ids["$ignored_url"]="$archive_id"
		queued_kinds["$ignored_url"]="$ignored_kind"
	 done

	if [[ -n "$filter_by_id" ]]; then
		if (( ${#queued_urls[@]} == 0 )); then
			__error "no archive urls for id %s" "$filter_by_id"
			local_exit_failsafe
		fi
		__info "re-archiving %s url(s) for id %s" "${#queued_urls[@]}" "$filter_by_id"
	fi

	if $archive_status || $archive_update_status; then
		print_archive_status "$archive_update_status"
		return 0
	fi

	local queued_url
	for queued_url in "${!queued_urls[@]}"; do
		manage_archive_for_url "$queued_url" "${queued_ids[$queued_url]}" "${queued_kinds[$queued_url]}"
	done

	if $archive_run_json_to_html; then
		handler_json_to_html_reconstruct
	fi

	return 0
}

function bibliography_archive(){
