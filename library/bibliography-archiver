#!/bin/bash

LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH="Build/libraries/ex10dead-book-bibliography/" # @todo set from outside
LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH="Build/libraries/" # @todo set from outside

source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format" || exit 1
source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/sourcetree-datafile-format/sourcetree-datafile-format.bibliography" || exit 1
source -- "$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_LIBRARY_PATH/build-base" || exit 1
source -- "./$LIBRARY_EX10DEAD_BOOK_BIBLIOGRAPHY_PATH/library/utilities/utilities" || exit 1

# configuration start

gallerydl_dump_directory_name="dump"
web_archive_directory_name="web-archive"
temporary_files_path="${TMPDIR:-/tmp}/bibliography-work"
wget_text_arguments=()
wget_text_arguments_file=""
declare -gA handler_enabled=()
declare -gA handler_output_path=()
declare -gA handler_leaf_name=()

# configuration end

# script start

apply_configuration_enables() {
	verify_handler_layout

	if [[ "${handler_enabled["twitter-archive-write-tweet-with-gallerydl"]}" == "true" ]]; then
		archive_run_gallerydl=true
	fi
	if [[ "$archive_run_gallerydl" == "true" && "${handler_twitter_archive_write_tweet_with_gallerydl_sourced-}" != "true" ]]; then
		load_handler "./handlers/twitter-archive-write-tweet-with-gallerydl"
	fi

	if [[ "${handler_enabled["webpage-archive-write-webpage-with-wget"]}" == "true" ]]; then
		archive_run_wget=true
	fi
	if [[ "$archive_run_wget" == "true" && "${handler_webpage_archive_write_webpage_with_wget_sourced-}" != "true" ]]; then
		load_handler "./handlers/webpage-archive-write-webpage-with-wget"
	fi

	if [[ "${handler_enabled["webpage-archive-write-webpage-light-with-wget"]}" == "true" ]]; then
		archive_run_wget_text=true
	fi
	if [[ "$archive_run_wget_text" == "true" && "${handler_webpage_archive_write_webpage_light_with_wget_sourced-}" != "true" ]]; then
		load_handler "./handlers/webpage-archive-write-webpage-light-with-wget"
	fi

	if [[ "${handler_enabled["webpage-archive-write-screenshot-with-screenshot-scraper"]}" == "true" ]]; then
		archive_run_make_screenshot=true
	fi
	if [[ "$archive_run_make_screenshot" == "true" && "${handler_webpage_archive_write_screenshot_with_screenshot_scraper_sourced-}" != "true" ]]; then
		load_handler "./handlers/webpage-archive-write-screenshot-with-screenshot-scraper"
	fi

	if [[ "${handler_enabled["webpage-archive-write-html-with-singlefile"]}" == "true" ]]; then
		archive_run_singlefile=true
	fi
	if [[ "$archive_run_singlefile" == "true" && "${handler_webpage_archive_write_html_with_singlefile_sourced-}" != "true" ]]; then
		load_handler "./handlers/webpage-archive-write-html-with-singlefile"
	fi

	if [[ "${handler_enabled["twitter-archive-export-write-conversation-reconstructed-html"]}" == "true" ]]; then
		archive_run_json_to_html=true
	fi
	if [[ "$archive_run_json_to_html" == "true" && "${handler_twitter_archive_export_write_conversation_reconstructed_html_sourced-}" != "true" ]]; then
		load_handler "./handlers/twitter-archive-export-write-conversation-reconstructed-html"
	fi

	if [[ "${handler_enabled["twitter-manage-archive-cleanup-duplicate-files"]}" == "true" ]]; then
		archive_run_cleanup=true
	fi
	if [[ "$archive_run_cleanup" == "true" && "${handler_twitter_manage_archive_cleanup_duplicate_files_sourced-}" != "true" ]]; then
		load_handler "./handlers/twitter-manage-archive-cleanup-duplicate-files"
	fi

	if [[ -n "${handler_output_path["twitter-archive-write-tweet-with-gallerydl"]-}" ]]; then
		gallerydl_dump_directory_name="${handler_output_path["twitter-archive-write-tweet-with-gallerydl"]}"
	fi
	if [[ -n "${handler_output_path["webpage-archive-write-webpage-with-wget"]-}" ]]; then
		web_archive_directory_name="${handler_output_path["webpage-archive-write-webpage-with-wget"]}"
	fi
}

setup_run_logging() {
	run_directory="$archive_path/run/run-$(date "+%d.%m.%Y [%H∶%M∶%S]")"
	run_error_log="$run_directory/error.log"
	run_default_log="$run_directory/default.log"
	failed_items_log="$run_directory/failed-items.log"
	mkdir --parents -- "$run_directory"
	: >| "$run_error_log"
	: >| "$run_default_log"

	declare -ga run_failed_item_logs=()
	local handler_name
	local log_path
	for handler_name in \
		"twitter-archive-write-tweet-with-gallerydl" \
		"webpage-archive-write-webpage-with-wget" \
		"webpage-archive-write-webpage-light-with-wget" \
		"webpage-archive-write-screenshot-with-screenshot-scraper" \
		"webpage-archive-write-html-with-singlefile" \
		"twitter-archive-export-write-conversation-reconstructed-html" \
		"twitter-manage-archive-cleanup-duplicate-files"
	do
		log_path="$run_directory/${handler_name}-failed-items.log"
		: >| "$log_path"
		run_failed_item_logs+=("$log_path")
	done

	replace_symlink "$run_directory" "$archive_path/run/current"
	replace_symlink "$run_default_log" "$archive_path/default.log"
	replace_symlink "$run_error_log" "$archive_path/error.log"
	replace_symlink "$failed_items_log" "$archive_path/failed-items.log"

	__setup_logging "$run_default_log" "$run_error_log"
}

close_run_logging() {
	__setup_logging "" ""

	__erase_empty_file "$run_default_log"
	__erase_empty_file "$run_error_log"

	local log_path
	for log_path in "${run_failed_item_logs[@]}"; do
		__erase_empty_file "$log_path"
	done

	local placeholder
	if [[ ! -f "$run_default_log" ]]; then
		placeholder="$archive_path/run/empty-default.log"
		: >| "$placeholder"
		replace_symlink "$placeholder" "$archive_path/default.log"
	fi
	if [[ ! -f "$run_error_log" ]]; then
		placeholder="$archive_path/run/empty-error.log"
		: >| "$placeholder"
		replace_symlink "$placeholder" "$archive_path/error.log"
	fi
	if [[ ! -f "$failed_items_log" ]]; then
		placeholder="$archive_path/run/empty-error.log"
		: >| "$placeholder"
		replace_symlink "$placeholder" "$archive_path/failed-items.log"
	fi
}

status_wanted() {
	local zip_ok="$1"
	local singlefile_ok="$2"
	local screenshot_ok="$3"
	local gallerydl_ok="$4"
	local remote="${5-}"
	local wget_text_ok="${6:-true}"
	local reconstruct_ok="${7:-true}"
	if ! $show_archived && ! $show_missing && ! $show_missing_wget \
		&& ! $show_missing_singlefile && ! $show_missing_screenshot \
		&& ! $show_missing_gallerydl && ! $show_missing_download \
		&& ! $show_missing_wget_text && ! $show_missing_thread_html; then
		return 0
	fi

	local wget_ok=true
	local sf_ok=true
	local shot_ok=true
	local gdl_ok=true
	local text_ok=true
	local html_ok=true
	if $archive_run_wget; then
		wget_ok=$zip_ok
	fi
	if $archive_run_singlefile; then
		sf_ok=$singlefile_ok
	fi
	if $archive_run_make_screenshot; then
		shot_ok=$screenshot_ok
	fi
	if $archive_run_gallerydl; then
		gdl_ok=$gallerydl_ok
	fi
	if $archive_run_wget_text; then
		text_ok=$wget_text_ok
	fi
	if $archive_run_json_to_html; then
		html_ok=$reconstruct_ok
	fi

	local want=false
	if $show_archived && $wget_ok && $sf_ok && $shot_ok && $gdl_ok && $text_ok && $html_ok; then
		want=true
	fi
	if $show_missing; then
		if ! $wget_ok || ! $sf_ok || ! $shot_ok || ! $gdl_ok || ! $text_ok || ! $html_ok; then
			want=true
		fi
	fi
	if $show_missing_wget && ! $zip_ok; then
		want=true
	fi
	if $show_missing_singlefile && ! $singlefile_ok; then
		want=true
	fi
	if $show_missing_screenshot && ! $screenshot_ok; then
		want=true
	fi
	if $show_missing_gallerydl && ! $gallerydl_ok; then
		want=true
	fi
	if $show_missing_wget_text && ! $wget_text_ok; then
		want=true
	fi
	if $show_missing_thread_html && ! $reconstruct_ok; then
		want=true
	fi
	if $show_missing_download && [[ "$remote" == download* || "$remote" == remote-newer* || "$remote" == etag-differs* ]]; then
		want=true
	fi
	$want
}

print_archive_status() {
	local probe="${1:-false}"
	local screenshot_existing=0
	local screenshot_missing=0
	local wget_existing=0
	local wget_missing=0
	local singlefile_existing=0
	local singlefile_missing=0
	local gallerydl_existing=0
	local gallerydl_missing=0
	local wget_text_existing=0
	local wget_text_missing=0
	local reconstruct_existing=0
	local reconstruct_missing=0
	local url_count=0
	local shown=0

	local queued_url
	for queued_url in "${!queued_urls[@]}"; do
		url_count=$((url_count + 1)) || __expression_may_fail
		local id="${queued_ids["$queued_url"]}"
		local work_directory
		work_directory="$(handler_id_directory "webpage-archive-write-webpage-with-wget" "$id")"
		local zip_archive
		zip_archive="$(archive_zip_path "$queued_url" "$id" "${queued_kinds["$queued_url"]}" "webpage-archive-write-webpage-with-wget")"

		local zip_ok=false
		local singlefile_ok=false
		local screenshot_ok=false
		local gallerydl_ok=false
		local wget_text_ok=false
		local reconstruct_ok=false
		local remote_note=""
		local zip_display="$zip_archive"
		if [[ "$zip_archive" == "$__current_directory"* ]]; then
			zip_display="${zip_archive#"$__current_directory"}"
		fi
		if [[ "$zip_display" == "$archive_path"* ]]; then
			zip_display="${zip_display#"$archive_path"}"
		fi
		local screenshot_file
		screenshot_file="$(handler_leaf_directory "webpage-archive-write-screenshot-with-screenshot-scraper" "$id")/screenshot.png"

		local screenshot_display="$screenshot_file"
		if [[ "$screenshot_file" == "$__current_directory"* ]]; then
			screenshot_display="${screenshot_file#"$__current_directory"}"
		fi
		if [[ "$screenshot_display" == "$archive_path"* ]]; then
			screenshot_display="${screenshot_display#"$archive_path"}"
		fi
		screenshot_display="${screenshot_display#/}"
		local singlefile_path
		singlefile_path="$(handler_leaf_directory "webpage-archive-write-html-with-singlefile" "$id")/$(basename -- "$zip_archive" .zip).singlefile.html"

		local singlefile_display="${singlefile_path#"$archive_path"}"
		singlefile_display="${singlefile_display#/}"
		zip_display="${zip_display#/}"
		local gallerydl_file=""
		local gallerydl_display=""
		local tweet_id
		tweet_id="$(twitter_status_id "$queued_url")" || tweet_id=""

		gallerydl_file="$(gallerydl_json_for_url "$queued_url")" || gallerydl_file=""
		if [[ -n "$gallerydl_file" && -f "$gallerydl_file" ]]; then
			gallerydl_display="${gallerydl_file#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
			gallerydl_ok=true
		elif [[ -n "$tweet_id" ]]; then
			gallerydl_display="$(handler_leaf_directory "twitter-archive-write-tweet-with-gallerydl" "$id")/${tweet_id}.json"
			gallerydl_display="${gallerydl_display#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
		else
			gallerydl_display="Missing json in: $(handler_leaf_directory "twitter-archive-write-tweet-with-gallerydl" "$id")/"
			gallerydl_display="${gallerydl_display#"$archive_path"}"
			gallerydl_display="${gallerydl_display#/}"
		fi

		local wget_text_target
		if $wget_text_output_as_zip; then
			wget_text_target="$(archive_zip_path "$queued_url" "$id" "${queued_kinds["$queued_url"]}" "webpage-archive-write-webpage-light-with-wget")"
		else
			wget_text_target="$(handler_leaf_directory "webpage-archive-write-webpage-light-with-wget" "$id")/$(basename -- "$id")/SUCCESSFUL_DOWNLOAD"
		fi
		local wget_text_display="${wget_text_target#"$archive_path"}"
		wget_text_display="${wget_text_display#/}"
		local reconstruct_file
		reconstruct_file="$(handler_leaf_directory "twitter-archive-export-write-conversation-reconstructed-html" "$id")/reconstructed-twitter-thread.html"
		local reconstruct_display="${reconstruct_file#"$archive_path"}"
		reconstruct_display="${reconstruct_display#/}"

		if [[ -f "$zip_archive" ]]; then
			zip_ok=true
		fi
		if [[ -f "$singlefile_path" ]]; then
			singlefile_ok=true
		fi
		if [[ -f "$screenshot_file" ]]; then
			screenshot_ok=true
		fi
		if [[ -f "$wget_text_target" ]]; then
			wget_text_ok=true
		fi
		if [[ -f "$reconstruct_file" ]]; then
			reconstruct_ok=true
		fi
		if $archive_run_make_screenshot; then
			if $screenshot_ok; then
				screenshot_existing=$((screenshot_existing + 1)) || __expression_may_fail
			else
				screenshot_missing=$((screenshot_missing + 1)) || __expression_may_fail
			fi
		fi
		if $archive_run_wget; then
			if $zip_ok; then
				wget_existing=$((wget_existing + 1)) || __expression_may_fail
			else
				wget_missing=$((wget_missing + 1)) || __expression_may_fail
			fi
		fi
		if $archive_run_singlefile; then
			if $singlefile_ok; then
				singlefile_existing=$((singlefile_existing + 1)) || __expression_may_fail
			else
				singlefile_missing=$((singlefile_missing + 1)) || __expression_may_fail
			fi
		fi
		if $archive_run_gallerydl; then
			if $gallerydl_ok; then
				gallerydl_existing=$((gallerydl_existing + 1)) || __expression_may_fail
			else
				gallerydl_missing=$((gallerydl_missing + 1)) || __expression_may_fail
			fi
		fi
		if $archive_run_wget_text; then
			if $wget_text_ok; then
				wget_text_existing=$((wget_text_existing + 1)) || __expression_may_fail
			else
				wget_text_missing=$((wget_text_missing + 1)) || __expression_may_fail
			fi
		fi
		if $archive_run_json_to_html; then
			if $reconstruct_ok; then
				reconstruct_existing=$((reconstruct_existing + 1)) || __expression_may_fail
			else
				reconstruct_missing=$((reconstruct_missing + 1)) || __expression_may_fail
			fi
		fi

		if $probe && $archive_run_wget; then
			local -a curl_args=(--silent --head --location --write-out "%{http_code}" --max-time 10)
			if [[ -n "${gallery_dl_cookie_file-}" && -f "$gallery_dl_cookie_file" ]]; then
				curl_args+=(--cookie "$gallery_dl_cookie_file")
			fi
			local headers
			local status=0
			local http_status
			headers="$(curl "${curl_args[@]}" -- "$queued_url")" || status="$(abort_on_interrupt "$?")"

			if (( status != 0 )); then
				headers=""
			fi
			http_status="${headers: -3}"
			http_status="${http_status:-000}"

			if [[ -z "$headers" || "$http_status" == "000" ]]; then
				remote_note="unreachable"
			elif [[ "$http_status" != 2* ]]; then
				remote_note="http ${http_status}"
			else
				local last_modified

				last_modified="$(printf '%s\n' "$headers" | { grep --ignore-case '^last-modified:' || __expression_may_fail; } | head --lines=1 | cut --delimiter=":" --fields="2-" )"
				last_modified="${last_modified-}"
				last_modified="${last_modified#"${last_modified%%[![:space:]]*}"}"
				last_modified="${last_modified%"${last_modified##*[![:space:]]}"}"
				local etag
				etag="$(printf '%s\n' "$headers" | { grep --ignore-case '^etag:' || __expression_may_fail; } | head --lines=1 | cut --delimiter=: --fields=2- | tr --delete '\" ')"
				local remote_mtime=0
				status=0
				if [[ -n "$last_modified" ]]; then
					remote_mtime="$(date --date="$last_modified" "+%s")" || status="$(abort_on_interrupt "$?")"
					if (( status != 0 )); then
						__error "bad Last-Modified %s" "$last_modified"
						return "$status"
					fi
				fi

				local local_mtime=0
				status=0
				if [[ -f "$zip_archive" ]]; then
					local_mtime="$(stat --format="%Y" -- "$zip_archive")" || status="$(abort_on_interrupt "$?")"
					if (( status != 0 )); then
						__error "cannot stat %s" "$zip_archive"
						return "$status"
					fi
					remote_note="$(archive_status_etag_note "$zip_archive" "$etag" "$zip_ok" "$remote_mtime" "$local_mtime")"
				fi
			fi
		fi

		expected_archive_stems["$(basename -- "$id")"]=1
		if $archive_run_make_screenshot || $archive_run_wget || $archive_run_singlefile || $archive_run_wget_text || $archive_run_json_to_html; then
			expected_archive_paths["$(archive_relative "$(handler_id_directory "webpage-archive-write-webpage-with-wget" "$id")")"]=1
		fi
		if $archive_run_gallerydl; then
			expected_archive_paths["$(archive_relative "$(handler_id_directory "twitter-archive-write-tweet-with-gallerydl" "$id")")"]=1
		fi

		local leaf
		leaf="${handler_leaf_name["webpage-archive-write-webpage-with-wget"]-"webpage-archive-write-webpage-with-wget"}"
		local stem_name
		stem_name="$(basename -- "$id")"
		expected_archive_stems["$stem_name"]=1
		expected_archive_paths["$leaf/$stem_name.zip"]=1
		expected_archive_paths["$leaf/$stem_name.zip.etag"]=1
		if $archive_run_singlefile; then
			local sf_leaf
			sf_leaf="${handler_leaf_name["webpage-archive-write-html-with-singlefile"]-"webpage-archive-write-html-with-singlefile"}"
			expected_archive_paths["$sf_leaf/$stem_name.singlefile.html"]=1
		fi

		if ! status_wanted "$zip_ok" "$singlefile_ok" "$screenshot_ok" "$gallerydl_ok" "$remote_note" "$wget_text_ok" "$reconstruct_ok"; then
			continue
		fi

		shown=$((shown + 1)) || __expression_may_fail

		__heading "%s" "$queued_url"

		if $archive_run_make_screenshot; then
			local screenshot_status
			local screenshot_status_color
			if $screenshot_ok; then
				screenshot_status="archived"
				screenshot_status_color="${__COLOR_SUCCESS}"
			else
				screenshot_status="missing"
				screenshot_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$screenshot_status_color"'%s'"${COLOR_RESET1}"']\n\tscreenshot:\t%s\n' "${screenshot_status^^}" "$screenshot_display"
		fi

		if $archive_run_gallerydl; then
			local gallerydl_status
			local gallerydl_status_color
			if $gallerydl_ok; then
				gallerydl_status="archived"
				gallerydl_status_color="${__COLOR_SUCCESS}"
			else
				gallerydl_status="missing"
				gallerydl_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$gallerydl_status_color"'%s'"${COLOR_RESET1}"']\n\tgallery-dl:\t%s\n' "${gallerydl_status^^}" "$gallerydl_display"
		fi

		if $archive_run_singlefile; then
			local singlefile_status
			local singlefile_status_color
			if $singlefile_ok; then
				singlefile_status="archived"
				singlefile_status_color="${__COLOR_SUCCESS}"
			else
				singlefile_status="missing"
				singlefile_status_color="${__COLOR_WARNING}"
			fi
			printf '['"$singlefile_status_color"'%s'"${COLOR_RESET1}"']\n\tsinglefile:\t%s\n' "${singlefile_status^^}" "$singlefile_display"
		fi

		if $archive_run_wget; then
			local status
			local status_color
			if $zip_ok; then
				status="archived"
				status_color="${__COLOR_SUCCESS}"
			else
				status="missing"
				status_color="${__COLOR_WARNING}"
			fi
			if [[ -n "$remote_note" ]]; then
				status="$status/${remote_note}"
			fi
			printf '['"$status_color"'%s'"${COLOR_RESET1}"']\n\twget:\t\t%s\n' "${status^^}" "$zip_display"
		fi
		if $archive_run_wget_text; then
			local wget_text_status
			local wget_text_color
			if $wget_text_ok; then
				wget_text_status="archived"
				wget_text_color="${__COLOR_SUCCESS}"
			else
				wget_text_status="missing"
				wget_text_color="${__COLOR_WARNING}"
			fi
			printf '['"$wget_text_color"'%s'"${COLOR_RESET1}"']\n\twget-text:\t%s\n' "${wget_text_status^^}" "$wget_text_display"
		fi
		if $archive_run_json_to_html; then
			local reconstruct_status
			local reconstruct_color
			if $reconstruct_ok; then
				reconstruct_status="archived"
				reconstruct_color="${__COLOR_SUCCESS}"
			else
				reconstruct_status="missing"
				reconstruct_color="${__COLOR_WARNING}"
			fi
			printf '['"$reconstruct_color"'%s'"${COLOR_RESET1}"']\n\tthread-html:\t%s\n' "${reconstruct_status^^}" "$reconstruct_display"
		fi
	done

	if (( shown == 0 )) && { $show_missing || $show_missing_wget || $show_missing_singlefile \
		|| $show_missing_screenshot || $show_missing_gallerydl || $show_missing_wget_text \
		|| $show_missing_thread_html || $show_missing_download; }; then
		__info "no missing entries"
	fi

	__heading "Archive status"
	__info "urls %s" "$url_count"
	if $archive_run_gallerydl; then
		__info "gallery-dl count existing %s, count missing %s" "$gallerydl_existing" "$gallerydl_missing"
	fi
	if $archive_run_make_screenshot; then
		__info "screenshot count existing %s, count missing %s" "$screenshot_existing" "$screenshot_missing"
	fi
	if $archive_run_wget; then
		__info "wget count existing %s, count missing %s" "$wget_existing" "$wget_missing"
	fi
	if $archive_run_singlefile; then
		__info "singlefile count existing %s, count missing %s" "$singlefile_existing" "$singlefile_missing"
	fi
	if $archive_run_wget_text; then
		__info "wget-text count existing %s, count missing %s" "$wget_text_existing" "$wget_text_missing"
	fi
	if $archive_run_json_to_html; then
		__info "thread-html count existing %s, count missing %s" "$reconstruct_existing" "$reconstruct_missing"
	fi

	local scanned=0
	local -a orphans=()
	local -a scan_roots=()

	if [[ -d "$web_archive_path" ]]; then
		scan_roots+=("$web_archive_path")
	fi
	if [[ -d "$gallerydl_dump_path" ]]; then
		scan_roots+=("$gallerydl_dump_path")
	fi
	if ((${#scan_roots[@]} == 0)); then
		return 0
	fi

	local dump_name
	dump_name="$(archive_relative "$gallerydl_dump_path")"
	local web_name
	web_name="$(archive_relative "$web_archive_path")"

	__info "scanning archive trees for orphans"
	local file
	while IFS= read -r -d '' file; do
		scanned=$((scanned + 1)) || __expression_may_fail
		if (( scanned % 2000 == 0 )); then
			__info "orphan scan %s paths" "$scanned"
		fi

		local relative_file
		relative_file="$(archive_relative "$file")"

		local base
		base="$(basename -- "$relative_file")"

		local stem="$base"
		stem="${stem%.etag}"
		stem="${stem%.zip}"
		stem="${stem%.singlefile.html}"
		if [[ -n "${expected_archive_stems["$stem"]+set}" ]]; then
			continue
		fi

		case "$relative_file" in
			""|"$dump_name"|"$web_name") continue ;;
		esac

		if [[ -n "${expected_archive_paths["$relative_file"]+set}" ]]; then
			continue
		fi
		local under_expected=false
		local parent="$relative_file"
		while [[ "$parent" == */* ]]; do
			parent="${parent%/*}"
			if [[ -n "${expected_archive_paths["$parent"]+set}" ]]; then
				under_expected=true
				break
			fi
		done
		if $under_expected; then
			continue
		fi

		case "$relative_file" in
#			*/__backups|*/__backups/*) continue ;;
			"$dump_name"/gallery-dl.cache.sqlite3*) continue ;;
			*.manifest|*/SUCCESSFUL_DOWNLOAD) continue ;;
		esac

		case "$base" in
			SUCCESSFUL_DOWNLOAD) continue ;;
#			__backups) continue ;;
		esac

		if [[ "$relative_file" == "$dump_name"/* ]]; then
			local dump_directory="$file"
			if [[ -f "$file" ]]; then
				dump_directory="$(dirname -- "$file")"
			fi
			if [[ "$(basename -- "$dump_directory")" == "$reserved_data_name" ]]; then
				local tweet_directory
				tweet_directory="$(dirname -- "$dump_directory")"
				local tweet_id
				tweet_id="$(basename -- "$tweet_directory")"
				if [[ -f "$dump_directory/$tweet_id.json" ]]; then
					continue
				fi
			fi
		fi
#		if [[ "$relative_file" == "$dump_name"/* ]]; then
#			local dump_directory="$file"
#			if [[ -f "$file" ]]; then
#				dump_directory="$(dirname -- "$file")"
#			fi
#			local dump_id
#			dump_id="$(basename -- "$dump_directory")"
#			if [[ -f "$dump_directory/$dump_id.json" ]]; then
#				continue
#			fi
#		fi

		case "$base" in
			*.zip|*.zip.etag|*.singlefile.html|*.json|*.JSON|screenshot.png|reconstructed-twitter-thread.html) ;;
			*.jpg|*.jpeg|*.png|*.gif|*.webp|*.mp4|*.txt) ;;
			*)
				if [[ ! -d "$file" ]]; then
					continue
				fi
				local -a children=("$file"/*)
				if ((${#children[@]} > 0)); then
					continue
				fi
				;;
		esac

		orphans+=("$relative_file")
	done < <(find "${scan_roots[@]}" \( -type f -o -type d \) -print0)
	__info "orphan scan finished, %s paths, %s orphans" "$scanned" "${#orphans[@]}"

	if ((${#orphans[@]} > 0)); then
		__heading "Not in bibliography"
		local orphan
		for orphan in "${orphans[@]}"; do
			__info "orphan archive path %s" "${orphan#"$__current_directory"}"
		done
	fi
}

manage_archive_for_url() {
	local url="$1"
	local url_identifier="$2"
	local url_kind="$3"

	__verbose "handling url %s" "$url"

	local target_directory_name
	target_directory_name="$(handler_id_directory "webpage-archive-write-webpage-with-wget" "$url_identifier")"
	local zip_archive
	zip_archive="$(archive_zip_path "$url" "$url_identifier" "$url_kind" "webpage-archive-write-webpage-with-wget")"
	local singlefile_path
	singlefile_path="$(handler_leaf_directory "webpage-archive-write-html-with-singlefile" "$url_identifier")/$(basename -- "$zip_archive" .zip).singlefile.html"
	local screenshot_path
	screenshot_path="$(handler_leaf_directory "webpage-archive-write-screenshot-with-screenshot-scraper" "$url_identifier")/screenshot.png"

	local wget_status=0
	local singlefile_status=0
	local screenshot_status=0
	local gallerydl_status=0
	local wget_text_status=0

	if $archive_run_wget; then
		handler_webpage_archive_write_webpage_with_wget_download "$url" "$target_directory_name/" "$url_identifier" "$url_kind" || wget_status=$?
		if (( wget_status == 130 || wget_status == 143 )); then
			exit "$wget_status"
		fi
		if (( wget_status != 0 )); then
			__failure "method failed for %s" "$url"
			__warn "archive incomplete for %s after wget status %s" "$url" "$wget_status"
			return 0
		fi
		__success "method finished"
	fi
	if $archive_run_singlefile; then
		handler_webpage_archive_write_html_with_singlefile_download "$url" "$singlefile_path" || singlefile_status=$?
		if (( singlefile_status == 130 || singlefile_status == 143 )); then
			exit "$singlefile_status"
		fi
		if (( singlefile_status != 0 )); then
			__failure "method failed for %s" "$url"
			__warn "archive incomplete for %s after singlefile status %s" "$url" "$singlefile_status"
			return 0
		fi
		__success "method finished"
	fi
	if $archive_run_gallerydl; then
		handler_twitter_archive_write_tweet_with_gallerydl_download "$url" || gallerydl_status=$?
		if (( gallerydl_status == 130 || gallerydl_status == 143 )); then
			exit "$gallerydl_status"
		fi
		if (( gallerydl_status != 0 )); then
			__failure "method failed for %s" "$url"
			__warn "archive incomplete for %s after gallery-dl status %s" "$url" "$gallerydl_status"
			return 0
		fi
		__success "method finished"
	fi
	if $archive_run_wget_text; then
		local wget_text_domain="${url#*://}"
		wget_text_domain="${wget_text_domain%%/*}"
		local wget_text_out
		if $wget_text_output_as_zip; then
			wget_text_out="$(archive_zip_path "$url" "$url_identifier" "$url_kind" "webpage-archive-write-webpage-light-with-wget")"
		else
			wget_text_out="$(handler_leaf_directory "webpage-archive-write-webpage-light-with-wget" "$url_identifier")/$(basename -- "$url_identifier")"
		fi
		handler_webpage_archive_write_webpage_light_with_wget_download "$url" "$wget_text_domain" "$wget_text_out" || wget_text_status=$?
		if (( wget_text_status == 130 || wget_text_status == 143 )); then
			exit "$wget_text_status"
		fi
		if (( wget_text_status != 0 )); then
			__failure "method failed for %s" "$url"
			__warn "archive incomplete for %s after wget-text status %s" "$url" "$wget_text_status"
			return 0
		fi
		__success "method finished"
	fi
	if $archive_run_make_screenshot; then
		local screenshot_existed=false
		if [[ -f "$screenshot_path" ]] && ! $force_update_existing; then
			screenshot_existed=true
		fi

		handler_webpage_archive_write_screenshot_with_screenshot_scraper_download "$url" "$screenshot_path" || screenshot_status=$?
		if (( screenshot_status == 130 || screenshot_status == 143 )); then
			exit "$screenshot_status"
		fi
		if (( screenshot_status == 0 )) && ! $screenshot_existed; then
			local screenshot_pause
			screenshot_pause=$((5 + RANDOM % 10)) || __expression_may_fail
			__info "waiting %s seconds before the next screenshot" "$screenshot_pause"
			sleep "$screenshot_pause"
		fi
		if (( screenshot_status != 0 )); then
			__failure "method failed for %s" "$url"
			__warn "stopping %s after screenshot status %s" "$url" "$screenshot_status"
			return 0
		fi
		__success "method finished"
	fi

	local per_url_handler=false
	local wrote=false
	if $archive_run_wget; then
		per_url_handler=true
		if [[ -f "$zip_archive" ]]; then
			wrote=true
		fi
	fi
	if $archive_run_singlefile; then
		per_url_handler=true
		if [[ -f "$singlefile_path" ]]; then
			wrote=true
		fi
	fi
	if $archive_run_make_screenshot; then
		per_url_handler=true
		if [[ -f "$screenshot_path" ]]; then
			wrote=true
		fi
	fi
	if $archive_run_gallerydl; then
		per_url_handler=true
		local gallerydl_ok_file
		gallerydl_ok_file="$(gallerydl_json_for_url "$url")" || gallerydl_ok_file=""
		if [[ -f "$gallerydl_ok_file" ]]; then
			wrote=true
		fi
	fi
	if $archive_run_wget_text; then
		per_url_handler=true
		if $wget_text_output_as_zip; then
			if [[ -f "$(archive_zip_path "$url" "$url_identifier" "$url_kind" "webpage-archive-write-webpage-light-with-wget")" ]]; then
				wrote=true
			fi
		else
			if [[ -f "$(handler_leaf_directory "webpage-archive-write-webpage-light-with-wget" "$url_identifier")/$(basename -- "$url_identifier")/SUCCESSFUL_DOWNLOAD" ]]; then
				wrote=true
			fi
		fi
	fi
	if $per_url_handler && ! $wrote; then
		__error "no archive data written for %s" "$url"
	fi
}

extract_urls_from_bibliography() {
	generate_tree "-1" false false ""
	verify_tree
	declare -A url_owners=()

	if [[ "$filter_by_id" == http://* || "$filter_by_id" == https://* ]]; then
		archive_url_filter="$filter_by_id"
		filter_by_id=""
		local key
		local owner=""
		local owners=0
		for key in "${tree_order[@]}"; do
			local u
			u="$(get_metadata "_" "$key")"
			if [[ "$u" == "$archive_url_filter" ]]; then
				owner="$(get_metadata "_id" "$key")"
				if [[ -z "$owner" || "$owner" == *"※"* ]]; then
					owner="$(nearest_non_reference_parent_id "$key")" || owner=""
				fi
				if [[ -z "$owner" ]]; then
					owner="__root"
				fi
				url_owners["$owner"]=1
				filter_by_id="$owner"
				continue
			fi
			local field
			for field in url additional_url archive_url mirror_url; do
				while IFS= read -r u; do
					if [[ "$u" != "$archive_url_filter" ]]; then
						continue
					fi
					owner="$(get_metadata "_id" "$key")"
					if [[ -z "$owner" || "$owner" == *"※"* ]]; then
						owner="$(nearest_non_reference_parent_id "$key")" || owner=""
					fi
					if [[ -z "$owner" ]]; then
						owner="__root"
					fi
					url_owners["$owner"]=1
					filter_by_id="$owner"
				done < <(get_values "$key" "$field" true)
			done
		done

		owners="${#url_owners[@]}"
		if (( owners == 0 )); then
			__error "url is not in the bibliography: %s" "$archive_url_filter"
			local_exit_failsafe
		fi
		if (( owners > 1 )); then
			__error "url %s belongs to more than one title; pass --archive-id=TITLE/ and the url" "$archive_url_filter"
			local_exit_failsafe
		fi
		archive_id_with_extras=true
		__info "url %s belongs to %s" "$archive_url_filter" "$filter_by_id"
	fi
	declare -A title_urls=()
	declare -A queued_urls=()
	declare -A queued_ids=()
	declare -A queued_kinds=()
	declare -a ignored_reference_keys=()
	declare -a ignored_reference_urls=()
	declare -a ignored_reference_kinds=()
	wget_zip_paths_this_session=()

	local key
	for key in "${tree_order[@]}"; do
		local entry_key
		entry_key="$(get_entry_key "$key")"

		local type=""
		type="$(resolved_type "$key")" || type=""

		local data_kind=""
		if [[ -n "$type" ]]; then
			data_kind="${type#*":"}"
			type="${type%%":"*}"
			if [[ "$type" == "$data_kind" ]]; then
				data_kind=""
			fi
		fi

		local is_video_url=false
		if [[ "$type" == "video" && "$data_kind" == "url" ]]; then
			is_video_url=true
		fi

		local -a entry_data_urls=()
		local -a field_urls=()

		if $is_video_url; then
			mapfile -t field_urls < <(
				get_values "$key" "additional_url" true
				get_values "$key" "archive_url" true
				get_values "$key" "mirror_url" true
			)
		else
			if [[ "$data_kind" == "url" ]]; then
				mapfile -t entry_data_urls < <(get_metadata "_" "$key")
			fi
			mapfile -t field_urls < <(
				get_values "$key" "url" true
				get_values "$key" "additional_url" true
				get_values "$key" "archive_url" true
				get_values "$key" "mirror_url" true
			)
		fi

		if [[ -n "$archive_url_filter" ]]; then
			local main_url
			main_url="$(get_metadata "_" "$key")"
			if [[ "$main_url" == "$archive_url_filter" ]]; then
				field_urls+=("$main_url")
			fi
		fi

		if [[ "$entry_key" == *"※"* ]]; then
			__verbose "reference bibliography entry %s is ignored" "$entry_key"
			local ignored_url
			for ignored_url in "${entry_data_urls[@]}" "${field_urls[@]}"; do
				if [[ -z "$ignored_url" ]]; then
					continue
				fi
				ignored_reference_keys+=("$key")
				ignored_reference_urls+=("$ignored_url")
				ignored_reference_kinds+=("field")
			done

			continue
		fi

		local id
		id="$(get_metadata "_id" "$key")"
		if [[ -z "$id" || "$id" == *"※"* ]]; then
			local work_id=""
			work_id="$(nearest_non_reference_parent_id "$key")" || work_id=""
			if [[ -n "$work_id" ]]; then
				id="$work_id"
			elif [[ -z "$id" ]]; then
				__info "no _id on %s and no non-reference parent id; using __root" "$key"
				id="__root"
			else
				__warn "reference entry %s has no non-reference parent id; using __root" "$key"
				id="__root"
			fi
		fi

		local url_kind_entry="entry"
		local url_kind_field="field"
		if is_attribute_under_reference "$key"; then
			url_kind_entry="attribute-field"
			url_kind_field="attribute-field"
		fi

		local candidate
		for candidate in "${entry_data_urls[@]}"; do
			if [[ -z "$candidate" ]]; then
				continue
			fi
			title_urls["$candidate"]=1
			if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$id"; then
				continue
			fi
			if [[ -n "$archive_url_filter" && "$candidate" != "$archive_url_filter" ]]; then
				continue
			fi
			if $from_file_active && [[ -z "${from_file_urls["$candidate"]+set}" ]]; then
				continue
			fi
			if [[ -n "${queued_urls["$candidate"]+set}" ]]; then
				if [[ "$url_kind_entry" == "entry" ]]; then
					queued_kinds["$candidate"]="entry"
				fi
				continue
			fi
			queued_urls["$candidate"]=1
			queued_ids["$candidate"]="$id"
			queued_kinds["$candidate"]="$url_kind_entry"
		done

		for candidate in "${field_urls[@]}"; do
			if [[ -z "$candidate" ]]; then
				continue
			fi
			title_urls["$candidate"]=1
			if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$id"; then
				continue
			fi
			if [[ -n "$filter_by_id" ]] && ! $archive_id_with_extras; then
				continue
			fi
			if [[ -n "$archive_url_filter" && "$candidate" != "$archive_url_filter" ]]; then
				continue
			fi
			if $from_file_active && [[ -z "${from_file_urls["$candidate"]+set}" ]]; then
				continue
			fi
			if [[ -n "${queued_urls["$candidate"]+set}" ]]; then
				continue
			fi
			queued_urls["$candidate"]=1
			queued_ids["$candidate"]="$id"
			queued_kinds["$candidate"]="$url_kind_field"
		done
	done

	local i
	for ((i = 0; i < ${#ignored_reference_urls[@]}; i++)); do
		local ignored_key="${ignored_reference_keys["$i"]}"
		local ignored_url="${ignored_reference_urls["$i"]}"
		local ignored_kind="${ignored_reference_kinds["$i"]}"

		if [[ -n "${title_urls["$ignored_url"]+set}" ]]; then
			continue
		fi

		local ignored_entry_key
		ignored_entry_key="$(get_entry_key "$ignored_key")"

		local archive_id=""
		if [[ "$ignored_entry_key" == *"※"* ]]; then
			archive_id="$(nearest_non_reference_parent_id "$ignored_key")" || archive_id=""
		fi
		if [[ -z "$archive_id" ]]; then
			archive_id="$(nearest_parent_id "$ignored_key")" || archive_id=""
		fi
		if [[ -z "$archive_id" ]]; then
			archive_id="__root"
		fi
		if [[ -n "$filter_by_id" ]] && ! archive_id_matches "$archive_id"; then
			continue
		fi
		if [[ -n "$filter_by_id" ]] && ! $archive_id_with_extras; then
			continue
		fi
		if [[ -n "$archive_url_filter" && "$ignored_url" != "$archive_url_filter" ]]; then
			continue
		fi
		if $from_file_active && [[ -z "${from_file_urls["$ignored_url"]+set}" ]]; then
			continue
		fi
		if $__verbose; then
			__warn "reference entry %s (%s) has url %s that never appeared as a title entry; archiving under %s" "$ignored_entry_key" "$ignored_key" "$ignored_url" "$archive_id"
		fi

		if [[ -n "${queued_urls["$ignored_url"]+set}" ]]; then
			if [[ "$ignored_kind" == "entry" ]]; then
				queued_kinds["$ignored_url"]="entry"
			fi
			continue
		fi

		queued_urls["$ignored_url"]=1
		queued_ids["$ignored_url"]="$archive_id"
		queued_kinds["$ignored_url"]="$ignored_kind"
	done

	if [[ -n "$filter_by_id" ]]; then
		if (( ${#queued_urls[@]} == 0 )); then
			__error "no archive urls for id %s" "$filter_by_id"
			local_exit_failsafe
		fi
		__info "re-archiving %s url(s) for id %s" "${#queued_urls[@]}" "$filter_by_id"
	fi

	if $from_file_active; then
		__info "from-file selected %s url(s)" "${#queued_urls[@]}"
	fi

	if $archive_status || $archive_update_status; then
		print_archive_status "$archive_update_status"
		return 0
	fi

	local queued_url
	for queued_url in "${!queued_urls[@]}"; do
		manage_archive_for_url "$queued_url" "${queued_ids["$queued_url"]}" "${queued_kinds["$queued_url"]}"
	done

	if $archive_run_json_to_html; then
		if [[ -n "${filter_by_id-}" || "$from_file_active" == true ]]; then
			__warn "skipping twitter-archive-export-write-conversation-reconstructed-html: a single id or a from-file set was selected; reconstruction walks the whole bibliography"
		else
			handler_twitter_archive_export_write_conversation_reconstructed_html
		fi
	fi

	if $archive_run_cleanup; then
		if [[ -n "${filter_by_id-}" || "$from_file_active" == true ]]; then
			__warn "skipping twitter-manage-archive-cleanup-duplicate-files: a single id or a from-file set was selected; cleanup walks the whole dump"
		else
			handler_twitter_manage_archive_cleanup_duplicate_files
		fi
	fi

	return 0
}

bibliography_archive() {
	archive_path=""
	bibliography_name=""
	bibliography_sources_path=""

	if [[ $# -gt 0 && "$1" != --* ]]; then
		archive_path="$1"
		shift || __expression_may_fail
		if [[ $# -gt 0 && "$1" != --* ]]; then
			bibliography_name="$1"
			shift || __expression_may_fail
			if [[ $# -gt 0 && "$1" != --* ]]; then
				bibliography_sources_path="$1"
				shift || __expression_may_fail
			fi
		fi
	fi

	force_update_existing=false
	print_sources=false
	archive_status=false
	archive_update_status=false
	filter_by_id=""
	archive_url_filter=""
	archive_id_with_extras=false
	archive_run_wget=false
	archive_run_singlefile=false
	archive_run_gallerydl=false
	archive_run_make_screenshot=false
	archive_run_wget_text=false
	archive_run_json_to_html=false
	archive_run_cleanup=false
	update_archive=false
	show_archived=false
	show_missing=false
	show_missing_wget=false
	show_missing_singlefile=false
	show_missing_screenshot=false
	show_missing_download=false
	show_missing_gallerydl=false
	show_missing_wget_text=false
	show_missing_thread_html=false
	configuration_file=""
	wget_text_output_as_zip=true
	additional_arguments=""
	wget_text_arguments=()
	wget_text_arguments_file=""
	backup_existing_archive=false
	configuration_files=()
	from_file_active=false
	declare -gA from_file_urls=()
	declare -gA handler_remaining_arguments=()

	local -a handler_arguments=()
	while (($# > 0)); do
		if [[ "$1" == "--debug" ]]; then
			__debug=true
			shift || __expression_may_fail
		elif [[ "$1" == "--verbose" ]]; then
			__verbose=true
			shift || __expression_may_fail
		elif [[ "$1" == "--quiet" ]]; then
			__quiet=true
			shift || __expression_may_fail
		elif [[ "$1" == "--print" || "$1" == "--print-sources" ]]; then
			print_sources=true
			shift || __expression_may_fail
		elif [[ "$1" == "--warn-on-ids" ]]; then
			additional_arguments="--warn-on-ids $additional_arguments"
			shift || __expression_may_fail
		elif [[ "$1" == "--update-archive" ]]; then
			update_archive=true
			shift || __expression_may_fail
		elif [[ "$1" == "--status" ]]; then
			archive_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--status-updated" ]]; then
			archive_status=true
			archive_update_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-archived" ]]; then
			archive_status=true
			show_archived=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing" ]]; then
			archive_status=true
			show_missing=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-wget" ]]; then
			archive_status=true
			show_missing_wget=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-singlefile" ]]; then
			archive_status=true
			show_missing_singlefile=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-download" ]]; then
			archive_status=true
			show_missing_download=true
			archive_update_status=true
			shift || __expression_may_fail
		elif [[ "$1" == "--show-missing-gallerydl" ]]; then
			show_missing_gallerydl=true
			archive_status=true
