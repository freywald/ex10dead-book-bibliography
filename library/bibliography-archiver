		if [[ $# -gt 0 && "$1" != --* ]]; then
			bibliography_name="$1"
			shift || __expression_may_fail
			if [[ $# -gt 0 && "$1" != --* ]]; then
				bibliography_sources_path="$1"
				shift || __expression_may_fail
			fi
		fi
	fi

	force_update_existing=false
	print_sources=false
	archive_status=false
	archive_update_status=false
	filter_by_id=""
	archive_url_filter=""
	archive_id_with_extras=false
	archive_run_wget=false
	archive_run_singlefile=false
	archive_run_gallerydl=false
